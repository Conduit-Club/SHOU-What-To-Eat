---
import Layout from '../templates/Layout.astro';
---
<Layout title="内容审核"><main class="admin-page"><header><a href="/">← 返回餐厅目录</a><button id="reload" title="刷新审核队列" aria-label="刷新审核队列">↻</button></header><section class="admin-title"><p class="eyebrow">REVIEW WORKSPACE</p><h1>投稿审核</h1><p>Access 登录后查看私有投稿。审核通过只会创建内容 PR，不会直接发布。</p></section><div class="workspace"><nav><div class="queue-title"><h2>待审核</h2><button id="refresh-queue">刷新</button></div><div id="queue" role="list" aria-live="polite"><p class="muted">正在加载……</p></div><h2 class="publication-heading">发布记录</h2><div id="publications"></div></nav><article id="editor"><p class="muted">选择一条投稿开始审核。</p></article></div></main></Layout>
<script>
  type Submission = { id: string; entity_type: string; entity_id: string; original_json: string; revision_json: string; status: string; version: number; upload_state: string; expected_images: number; expected_review_images: number; snapshot_id: string; created_at: string };
  const queue = document.querySelector<HTMLElement>('#queue')!;
  const editor = document.querySelector<HTMLElement>('#editor')!;
  const publications = document.querySelector<HTMLElement>('#publications')!;
  let selected: Submission | null = null;
  async function api(path: string, init?: RequestInit) { const response = await fetch(`/api/v2/admin${path}`, { ...init, headers: { ...(init?.body ? { 'Content-Type': 'application/json' } : {}), ...init?.headers } }); const data = await response.json(); if (!response.ok) throw new Error(data.error?.message ?? '请求失败'); return data; }
  async function loadQueue() {
    queue.replaceChildren(Object.assign(document.createElement('p'), { textContent: '正在加载……', className: 'muted' }));
    try { const data = await api('/submissions?status=pending'); queue.replaceChildren(); if (!data.submissions.length) { queue.append(Object.assign(document.createElement('p'), { textContent: '目前没有待审核投稿。', className: 'muted' })); return; }
      for (const item of data.submissions as Submission[]) { const button = document.createElement('button'); button.className = item.id === selected?.id ? 'queue-item selected' : 'queue-item'; button.innerHTML = `<strong></strong><span></span><small></small>`; button.querySelector('strong')!.textContent = item.entity_type === 'venue' ? '餐厅 / 档口' : item.entity_type === 'food' ? '餐品' : '独立评价'; button.querySelector('span')!.textContent = item.entity_id; button.querySelector('small')!.textContent = `${item.upload_state === 'uploading' ? '图片待完成' : item.status} · ${new Date(item.created_at).toLocaleDateString('zh-CN')}`; button.addEventListener('click', () => openSubmission(item.id)); queue.append(button); }
    } catch (error) { queue.replaceChildren(Object.assign(document.createElement('p'), { textContent: error instanceof Error ? error.message : '无法加载审核队列。', className: 'error' })); }
  }
  async function renderMediaPreviews(submissionId: string, media: Array<{ id: string; slot: string; slot_index: number; alt: string; byte_size: number; width: number; height: number; object_state: string }>) {
    const container = editor.querySelector<HTMLElement>('.media-preview');
    if (!container) return;
    container.replaceChildren();
    if (!media.length) { container.textContent = '没有附加图片。'; return; }
    for (const asset of media) {
      const item = document.createElement('figure'); item.className = 'media-item';
      const image = document.createElement('img'); image.alt = asset.alt; image.loading = 'lazy';
      const caption = document.createElement('figcaption'); caption.textContent = `${asset.slot} · ${asset.slot_index + 1} · ${asset.width}×${asset.height} · ${Math.ceil(asset.byte_size / 1024)} KiB`;
      item.append(image, caption); container.append(item);
      try {
        const response = await fetch(`/api/v2/admin/submissions/${encodeURIComponent(submissionId)}/images/${encodeURIComponent(asset.id)}`);
        if (!response.ok) throw new Error('preview_unavailable');
        image.src = URL.createObjectURL(await response.blob());
      } catch { image.replaceWith(Object.assign(document.createElement('div'), { className: 'media-placeholder', textContent: '私有预览暂不可用' })); }
    }
  }
  async function openSubmission(id: string) {
    try { const data = await api(`/submissions/${encodeURIComponent(id)}`); selected = data.submission as Submission; const originalDocument = JSON.parse(selected.original_json); const revisionDocument = JSON.parse(selected.revision_json); const revision = revisionDocument.payload ?? revisionDocument; editor.innerHTML = `<div class="edit-head"><div><p class="eyebrow">${revisionDocument.entityType ?? selected.entity_type} · ${selected.id}</p><h2></h2><span class="muted"></span></div><span class="version"></span></div><div class="submission-facts"><span>实体 ${selected.entity_id}</span><span>快照 ${selected.snapshot_id}</span><span>图片 ${selected.expected_images} + 附评 ${selected.expected_review_images}</span></div><div class="media-preview"></div><label>原始投稿<textarea class="original" readonly></textarea></label><label>审核编辑稿（JSON）<textarea class="revision" rows="17" spellcheck="false"></textarea></label><label>拒绝理由 <input class="reason" maxlength="500" placeholder="拒绝时必填" /></label><div class="edit-actions"><button class="save">保存编辑</button><button class="reject">拒绝投稿</button><button class="approve">批准并创建 PR</button></div><p class="feedback" role="status" aria-live="polite"></p><h3>审核记录</h3><div class="audit"></div>`;
      const locationValue = revision.location;
      const locationText = locationValue && typeof locationValue === 'object' ? locationValue.address || locationValue.campusArea || locationValue.floor || revision.targetId : revision.address || locationValue || revision.targetId || '目标待补充';
      editor.querySelector('h2')!.textContent = String(revision.name ?? revision.title ?? revision.targetId ?? '未命名投稿'); editor.querySelector('.muted')!.textContent = String(locationText ?? '目标待补充'); editor.querySelector('.version')!.textContent = `版本 ${selected.version}`; (editor.querySelector('.original') as HTMLTextAreaElement).value = JSON.stringify(originalDocument, null, 2); (editor.querySelector('.revision') as HTMLTextAreaElement).value = JSON.stringify(revisionDocument, null, 2);
      renderMediaPreviews(id, data.media ?? []);
      editor.querySelector('.audit')!.textContent = data.audits.map((audit: { reviewer: string; action: string; created_at: string; reason: string | null }) => `${audit.action} · ${audit.reviewer} · ${new Date(audit.created_at).toLocaleString('zh-CN')}${audit.reason ? ` · ${audit.reason}` : ''}`).join('\n') || '暂无审核操作';
      editor.querySelector('.save')!.addEventListener('click', () => saveRevision()); editor.querySelector('.reject')!.addEventListener('click', () => review('reject')); editor.querySelector('.approve')!.addEventListener('click', () => review('approve')); await loadQueue();
    } catch (error) { editor.textContent = error instanceof Error ? error.message : '无法读取投稿。'; }
  }
  async function saveRevision() {
    if (!selected) return; const feedback = editor.querySelector<HTMLElement>('.feedback')!;
    try { const revision = JSON.parse((editor.querySelector('.revision') as HTMLTextAreaElement).value); const data = await api(`/submissions/${selected.id}`, { method: 'PATCH', body: JSON.stringify({ expectedVersion: selected.version, revision }) }); selected.version = Number(data.version ?? data.submission?.version); (editor.querySelector('.version') as HTMLElement).textContent = `版本 ${selected.version}`; feedback.textContent = '编辑稿已保存并记入审核记录。'; await loadQueue(); } catch (error) { feedback.textContent = error instanceof Error ? error.message : '保存失败。'; }
  }
  async function review(action: 'approve' | 'reject') {
    if (!selected) return; const feedback = editor.querySelector<HTMLElement>('.feedback')!;
    try { const revision = JSON.parse((editor.querySelector('.revision') as HTMLTextAreaElement).value); const reason = (editor.querySelector('.reason') as HTMLInputElement).value; const saved = await api(`/submissions/${selected.id}`, { method: 'PATCH', body: JSON.stringify({ expectedVersion: selected.version, revision }) }); selected.version = Number(saved.version ?? saved.submission?.version); const data = await api(`/submissions/${selected.id}/review`, { method: 'POST', body: JSON.stringify({ action, expectedVersion: selected.version, reason }) }); feedback.textContent = action === 'approve' ? `已批准并创建发布任务：${data.publicationJobId}` : '已拒绝并记录理由。'; selected = null; await loadQueue(); await loadPublications(); } catch (error) { feedback.textContent = error instanceof Error ? error.message : '审核操作失败。'; }
  }
  async function loadPublications() {
    try { const data = await api('/publications'); publications.replaceChildren(); for (const job of data.publications) { const item = document.createElement('div'); item.className = 'publication'; const title = document.createElement('strong'); title.textContent = `${job.submission_id.slice(0, 8)} · ${job.status}`; item.append(title); if (job.pr_url) { const link = document.createElement('a'); link.href = job.pr_url; link.target = '_blank'; link.rel = 'noreferrer'; link.textContent = '查看 PR ↗'; item.append(link); } if (['failed', 'closed'].includes(job.status)) { const retry = document.createElement('button'); retry.textContent = '重试'; retry.addEventListener('click', async () => { await api(`/publications/${job.id}/retry`, { method: 'POST' }); await loadPublications(); }); item.append(retry); } publications.append(item); } } catch (error) { publications.textContent = error instanceof Error ? error.message : '无法加载发布记录。'; }
  }
  document.querySelector('#reload')!.addEventListener('click', async () => { await loadQueue(); await loadPublications(); }); document.querySelector('#refresh-queue')!.addEventListener('click', loadQueue); loadQueue(); loadPublications();
</script>
<style>
  .admin-page{width:min(100%,1180px);margin:auto;padding:0 26px 55px}
  .admin-page>header{min-height:68px;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:12px 0;border-bottom:1px solid var(--line)}
  .admin-page>header a{display:flex;align-items:center;min-height:44px;color:var(--muted);font-size:12px;text-decoration:none}
  .admin-page>header button{display:grid;width:44px;height:44px;min-height:44px;place-items:center;padding:0;border:1px solid var(--line);border-radius:6px;background:transparent;color:var(--ink);font-size:19px;cursor:pointer}
  .admin-title{padding:30px 0 20px}
  .eyebrow{margin:0 0 8px;color:var(--orange);font-size:10px;letter-spacing:1px}
  .admin-title h1{margin:0;font-size:25px;letter-spacing:0;overflow-wrap:anywhere}
  .admin-title p:last-child,.muted{color:var(--muted);font-size:12px;line-height:1.8;overflow-wrap:anywhere}
  .workspace{display:grid;grid-template-columns:290px minmax(0,1fr);gap:24px;min-height:550px;border-top:1px solid var(--line)}
  .workspace nav{min-width:0;padding:17px 17px 17px 0;border-right:1px solid var(--line)}
  .queue-title{display:flex;justify-content:space-between;align-items:center;gap:12px}
  .queue-title h2,.publication-heading{font-size:13px}
  .queue-title button{min-height:44px;padding:0 8px;border:0;background:transparent;color:var(--orange);font-size:11px;cursor:pointer}
  .queue-item{display:grid;width:100%;min-height:44px;gap:5px;padding:12px;margin-top:7px;border:1px solid var(--line);border-radius:6px;background:transparent;color:var(--ink);text-align:left;cursor:pointer}
  .queue-item.selected{border-color:var(--orange);background:color-mix(in srgb,var(--orange) 7%,transparent)}
  .queue-item strong{font-size:12px;overflow-wrap:anywhere}
  .queue-item span,.queue-item small{min-width:0;overflow:hidden;color:var(--muted);font-size:10px;text-overflow:ellipsis;white-space:nowrap}
  .publication-heading{margin-top:27px}
  .publication{display:grid;gap:6px;padding:9px 0;border-top:1px solid var(--line);font-size:10px;overflow-wrap:anywhere}
  .publication a{color:var(--orange);min-height:44px;display:flex;align-items:center}
  .publication button{justify-self:start;min-height:44px;padding:0;border:0;background:transparent;color:var(--green);cursor:pointer}
  .workspace article{min-width:0;padding:20px 0}
  .edit-head{display:flex;justify-content:space-between;gap:12px;margin-bottom:18px}
  .edit-head>div{min-width:0}
  .edit-head h2{margin:0 0 5px;font-size:18px;overflow-wrap:anywhere}
  .edit-head .muted{margin:0}
  .version{flex:0 0 auto;color:var(--muted);font-size:10px;overflow-wrap:anywhere}
  .workspace article>label{display:grid;gap:6px;margin:12px 0;color:var(--muted);font-size:11px;overflow-wrap:anywhere}
  .workspace textarea,.workspace input{width:100%;min-height:44px;padding:10px;border:1px solid var(--line);border-radius:6px;background:transparent;color:var(--ink);font:11px/1.65 ui-monospace,monospace;overflow-wrap:anywhere}
  .workspace textarea{white-space:pre-wrap;word-break:break-word}
  .workspace textarea[readonly]{max-height:125px}
  .workspace input{font-family:inherit}
  .edit-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
  .edit-actions button{min-height:44px;padding:0 12px;border:1px solid var(--line);border-radius:5px;background:transparent;color:var(--ink);font-size:11px;cursor:pointer}
  .edit-actions .approve{border-color:var(--orange);background:var(--orange);color:white}
  .edit-actions .reject{color:#bb483d}
  .feedback{color:var(--green);font-size:11px;line-height:1.8;overflow-wrap:anywhere}
  .workspace article h3{margin-top:24px;font-size:12px}
  .audit{white-space:pre-line;color:var(--muted);font-size:10px;line-height:1.8;overflow-wrap:anywhere;word-break:break-word}
  .error{color:#c33;font-size:11px;overflow-wrap:anywhere}
  @media(max-width:900px){.workspace{grid-template-columns:245px minmax(0,1fr);gap:18px}}
  @media(max-width:700px){
    .admin-page{padding:0 16px 35px}
    .admin-title{padding-top:24px}
    .workspace{grid-template-columns:1fr;gap:0}
    .workspace nav{padding:15px 0;border-right:0;border-bottom:1px solid var(--line)}
    .workspace article{padding-top:15px}
    .workspace textarea,.workspace input{font-size:16px}
  }
  @media(max-width:360px){.admin-page{padding-right:16px;padding-left:16px}.edit-actions{display:grid}.edit-actions button{width:100%}}
</style>
<style>
  #queue :global(.queue-item){display:grid;width:100%;min-height:44px;gap:6px;padding:15px;margin-top:9px;border:1px solid var(--line);border-radius:18px;background:var(--surface-card);color:var(--ink);text-align:left;box-shadow:var(--shadow-card);cursor:pointer}#queue :global(.queue-item.selected){border-color:var(--orange);background:#fff2eb;box-shadow:var(--shadow-hover)}#queue :global(.queue-item strong){font-size:13px;overflow-wrap:anywhere}#queue :global(.queue-item span){min-width:0;overflow:hidden;color:var(--muted);font-size:11px;text-overflow:ellipsis;white-space:nowrap}#queue :global(.queue-item small){min-width:0;overflow:hidden;color:var(--muted);font-size:10px;text-overflow:ellipsis;white-space:nowrap}#queue :global(.muted),#queue :global(.error){color:var(--muted);font-size:12px;line-height:1.8;overflow-wrap:anywhere}#queue :global(.error){color:#c33}
  #publications :global(.publication){display:grid;gap:7px;padding:13px 0;border-top:1px solid var(--line);font-size:11px;overflow-wrap:anywhere}#publications :global(.publication a){display:flex;align-items:center;min-height:44px;color:var(--orange)}#publications :global(.publication button){justify-self:start;min-height:44px;padding:0;border:0;background:transparent;color:var(--green);cursor:pointer}
  #editor :global(.edit-head){display:flex;justify-content:space-between;gap:12px;margin-bottom:22px}#editor :global(.edit-head > div){min-width:0}#editor :global(.edit-head h2){margin:0 0 5px;color:var(--ink);font-size:24px;letter-spacing:-.03em;overflow-wrap:anywhere}#editor :global(.edit-head .muted){margin:0;color:var(--muted);font-size:12px;line-height:1.8;overflow-wrap:anywhere}#editor :global(.version){flex:0 0 auto;color:var(--muted);font-size:10px;overflow-wrap:anywhere}
  #editor :global(label){display:grid;gap:8px;margin:15px 0;color:var(--muted);font-size:11px;font-weight:800;overflow-wrap:anywhere}#editor :global(textarea),#editor :global(input){width:100%;min-height:50px;padding:12px 14px;border:1px solid var(--line);border-radius:16px;background:var(--surface-soft);color:var(--ink);font:13px/1.65 ui-monospace,monospace;overflow-wrap:anywhere}#editor :global(textarea){white-space:pre-wrap;word-break:break-word}#editor :global(textarea[readonly]){max-height:160px}#editor :global(input){font-family:inherit}#editor :global(textarea:focus),#editor :global(input:focus){border-color:var(--orange);box-shadow:0 0 0 4px rgba(255,107,53,.15);outline:0}
  #editor :global(.edit-actions){display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}#editor :global(.edit-actions button){min-height:48px;padding:0 15px;border:1px solid var(--line);border-radius:15px;background:transparent;color:var(--ink);font-size:11px;font-weight:800;cursor:pointer}#editor :global(.edit-actions .approve){border-color:var(--orange);background:var(--orange);color:#fff}#editor :global(.edit-actions .reject){color:#ad3e2d;background:#fff0ed}#editor :global(.feedback){color:var(--green);font-size:12px;line-height:1.8;overflow-wrap:anywhere}#editor :global(h3){margin-top:24px;font-size:12px}#editor :global(.audit){padding:13px;border-radius:15px;background:var(--surface-soft);color:var(--muted);font-size:11px;line-height:1.8;white-space:pre-line;overflow-wrap:anywhere;word-break:break-word}
  #editor :global(.submission-facts){display:flex;flex-wrap:wrap;gap:7px;margin:-8px 0 17px}#editor :global(.submission-facts span){padding:7px 10px;border-radius:999px;background:#f4f0eb;color:var(--muted);font-size:10px;overflow-wrap:anywhere}#editor :global(.media-preview){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:0 0 18px;padding:13px;border-radius:18px;background:#fffdf9;color:var(--muted);font-size:11px}#editor :global(.media-item){min-width:0;margin:0}#editor :global(.media-item img),#editor :global(.media-placeholder){display:grid;width:100%;aspect-ratio:1;place-items:center;overflow:hidden;border-radius:12px;background:#f5eee7;color:#b89a8d;font-size:10px;text-align:center}#editor :global(.media-item img){object-fit:cover}#editor :global(.media-item figcaption){margin-top:5px;color:var(--muted);font-size:9px;overflow-wrap:anywhere}
  @media(max-width:800px){#editor :global(textarea),#editor :global(input){font-size:16px}#editor :global(.media-preview){grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:360px){#editor :global(.edit-actions){display:grid}#editor :global(.edit-actions button){width:100%}}
</style>
<style>
  .admin-page{width:min(calc(100% - 32px),1200px);padding:0 0 60px}.admin-page>header{min-height:84px;padding:0;border-bottom:1px solid var(--line)}.admin-page>header a{font-size:12px}.admin-page>header button{width:46px;height:46px;border:1px solid var(--line);border-radius:15px;background:var(--surface-card);color:var(--orange);box-shadow:var(--shadow-card)}
  .admin-title{padding:58px 0 28px}.admin-title h1{font-size:clamp(38px,5vw,58px);line-height:1.08;letter-spacing:-.05em}.admin-title p:last-child{max-width:650px;font-size:14px;line-height:1.85}
  .workspace{grid-template-columns:320px minmax(0,1fr);gap:25px;border:0}.workspace nav{padding:22px 18px 0 0;border-right:0;border-radius:26px}.queue-title{padding-bottom:10px}.queue-title h2,.publication-heading{font-size:18px}.queue-title button{min-height:44px;padding:0 13px;border-radius:12px;background:#fff2eb;color:var(--orange-deep);font-weight:800}.queue-item{gap:6px;padding:15px;margin-top:9px;border:1px solid var(--line);border-radius:18px;background:var(--surface-card);box-shadow:var(--shadow-card)}.queue-item.selected{border-color:var(--orange);background:#fff2eb;box-shadow:var(--shadow-hover)}.queue-item strong{font-size:13px}.queue-item span{font-size:11px}.queue-item small{font-size:10px}
  .publication-heading{margin-top:32px}.publication{gap:7px;padding:13px 0;font-size:11px}.publication a{min-height:44px}.workspace article{padding:22px 25px;border:1px solid rgba(255,107,53,.1);border-radius:28px;background:var(--surface-card);box-shadow:var(--shadow-card)}.edit-head{margin-bottom:22px}.edit-head h2{font-size:24px;letter-spacing:-.03em}.workspace article>label{gap:8px;margin:15px 0;font-size:11px;font-weight:800}.workspace textarea,.workspace input{min-height:50px;padding:12px 14px;border:1px solid var(--line);border-radius:16px;background:var(--surface-soft);font-size:13px}.workspace textarea:focus,.workspace input:focus{border-color:var(--orange);box-shadow:0 0 0 4px rgba(255,107,53,.15);outline:0}.workspace textarea[readonly]{max-height:160px}.edit-actions{gap:10px;margin-top:18px}.edit-actions button{min-height:48px;padding:0 15px;border-radius:15px;font-weight:800}.edit-actions .approve{border-color:var(--orange);background:var(--orange)}.edit-actions .reject{color:#ad3e2d;background:#fff0ed}.feedback{font-size:12px}.audit{padding:13px;border-radius:15px;background:var(--surface-soft);font-size:11px}
  @media(max-width:800px){.admin-page{width:min(calc(100% - 32px),1200px)}.workspace{grid-template-columns:1fr}.workspace nav{padding:15px 0}.workspace article{padding:21px}.workspace textarea,.workspace input{font-size:16px}}
  @media(max-width:360px){.admin-page{width:calc(100% - 32px)}.workspace article{padding:18px}.edit-actions{display:grid}.edit-actions button{width:100%}}
</style>
<style>
  .submission-facts{display:flex;flex-wrap:wrap;gap:7px;margin:-8px 0 17px}.submission-facts span{padding:7px 10px;border-radius:999px;background:#f4f0eb;color:var(--muted);font-size:10px;overflow-wrap:anywhere}.media-preview{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:0 0 18px;padding:13px;border-radius:18px;background:#fffdf9;color:var(--muted);font-size:11px}.media-item{min-width:0;margin:0}.media-item img,.media-placeholder{display:grid;width:100%;aspect-ratio:1;place-items:center;overflow:hidden;border-radius:12px;background:#f5eee7;color:#b89a8d;font-size:10px;text-align:center}.media-item img{object-fit:cover}.media-item figcaption{margin-top:5px;color:var(--muted);font-size:9px;overflow-wrap:anywhere}
</style>
