---
import { getCollection } from 'astro:content';
import Layout from '../../templates/Layout.astro';
import RestaurantFinder from '../../components/RestaurantFinder';
import { deriveDistanceTags } from '../../lib/catalog';
const [venueEntries, foodEntries, reviewEntries] = await Promise.all([
  getCollection('restaurants'), getCollection('foods'), getCollection('reviews'),
]);
const restaurants = venueEntries.map(({ data }) => ({ ...data, tags: deriveDistanceTags(data),
  reviewCount: reviewEntries.filter(({ data: review }) => review.targetType === 'venue' && review.targetId === data.id).length,
})).sort((a, b) => a.name.localeCompare(b.name, 'zh-CN'));
const foods = foodEntries.map(({ data }) => data);
---
<Layout title="餐厅与档口">
  <main class="venue-directory">
    <header class="directory-intro"><div><p>FIND YOUR NEXT STOP</p><h1>餐厅与档口<span>{restaurants.length} 个去处</span></h1><p class="intro-copy">先找一家店，再看看同学都点了什么。</p></div><a href="/">回到餐品食单 →</a></header>
    <RestaurantFinder client:load restaurants={restaurants} foods={foods} />
    <footer>价格、距离与营业信息以已知来源和现场为准。 <a href="/about/">关于本站 ↗</a></footer>
  </main>
</Layout>
<style>
  .venue-directory{width:calc(100% - clamp(32px,4vw,96px));margin:auto;padding-bottom:40px}.directory-intro{display:flex;justify-content:space-between;align-items:end;gap:24px;padding:42px 0 34px}.directory-intro p{margin:0;color:var(--orange-deep);font-size:11px;font-weight:750;letter-spacing:.08em}.directory-intro h1{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin:14px 0;font-size:clamp(30px,3.2vw,46px);letter-spacing:-.04em}.directory-intro h1 span{padding:7px 12px;border-radius:999px;background:#ffe9dd;color:var(--orange-deep);font-size:12px;letter-spacing:0}.directory-intro .intro-copy{font-weight:400;letter-spacing:0;font-size:14px;color:var(--muted)}.directory-intro>a{min-height:44px;display:flex;align-items:center;color:var(--orange-deep);font-size:13px;flex:none}footer{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-top:40px;padding:24px 0;border-top:1px solid var(--line);color:var(--muted);font-size:12px}footer a{min-height:44px}@media(max-width:640px){.directory-intro{align-items:start;flex-direction:column;gap:12px;padding-top:30px}}
</style>
