---
import { getCollection } from 'astro:content';
import Layout from '../../templates/Layout.astro';
import { renderSafeMarkdown, safeExternalUrl } from '../../utils/safe-markdown';

export const prerender = true;

export async function getStaticPaths() {
  const restaurants = await getCollection('restaurants');
  return restaurants.map((restaurant) => ({ params: { id: restaurant.id }, props: { restaurant } }));
}

const { restaurant } = Astro.props;
const categoryLabel = restaurant.data.category === 'on-campus' ? '校内' : '校外';
---

<Layout title={restaurant.data.name}>
  <main class="detail-page"><header class="top"><a href="/" class="back">← <span>返回餐厅列表</span></a><a class="submit" href={`/submit/?restaurant=${restaurant.data.id}`}>补充或纠错 <span aria-hidden="true">↗</span></a></header>
    <p class="crumb">{categoryLabel} <span>/</span> {restaurant.data.kind}</p><h1>{restaurant.data.name}</h1><p class="lead">{restaurant.data.location}</p>
    <div class="columns"><article>
      <section><h2>消费范围</h2><p>{restaurant.data.price}</p></section>
      {restaurant.data.openingHours && <section><h2>营业信息</h2><p>{restaurant.data.openingHours}</p></section>}
      {restaurant.data.foods.length > 0 && <section><h2>餐品与档口</h2><ul class="foods">{restaurant.data.foods.map((food) => <li><div><strong>{food.name}</strong>{food.location && <span class="food-location">{food.location}</span>}</div>{food.description && <p>{food.description}</p>}{food.price && <small>{food.price}</small>}</li>)}</ul></section>}
      <section><h2>同学评价 <span class="number">{restaurant.data.reviews.length}</span></h2>{restaurant.data.reviews.length ? <div class="reviews">{restaurant.data.reviews.map((review) => <blockquote><p>{review.text}</p><footer>— {review.author ?? '匿名同学'}{review.source && <span>{review.source}</span>}</footer></blockquote>)}</div> : <p class="muted">目前还没有同学评价。</p>}</section>
      {restaurant.data.body && <section><h2>补充说明</h2><div class="prose" set:html={renderSafeMarkdown(restaurant.data.body)} /></section>}
      {restaurant.data.images.filter((image) => safeExternalUrl(image.url)).map((image) => <figure><img src={image.url} alt={image.alt} loading="lazy" referrerpolicy="no-referrer" /><figcaption>{image.alt}{image.source && ` · 来源：${image.source}`}</figcaption></figure>)}
    </article><aside><h2>店铺信息</h2><dl><dt>位置</dt><dd>{restaurant.data.location}</dd><dt>分类</dt><dd>{categoryLabel} · {restaurant.data.kind}</dd><dt>最近记录</dt><dd>{restaurant.data.updatedAt ?? '日期待补充'}</dd></dl>{restaurant.data.coordinates && <a class="map" href={`https://www.openstreetmap.org/?mlat=${restaurant.data.coordinates[1]}&mlon=${restaurant.data.coordinates[0]}#map=17/${restaurant.data.coordinates[1]}/${restaurant.data.coordinates[0]}`} target="_blank" rel="noreferrer">在地图中查看 <span aria-hidden="true">↗</span></a>}<p class="source-note">评价是个人体验。位置、价格与营业信息可能变化，建议到店前核对。</p></aside></div>
    {restaurant.data.sources.length > 0 && <details class="sources"><summary>信息来源</summary><ul>{restaurant.data.sources.map((source) => <li>{source.repository} · {source.path} · {source.license ?? '授权状态待确认'}</li>)}</ul></details>}
  </main>
</Layout>

<style>
  .detail-page{width:min(100%,900px);margin:auto;padding:0 28px 60px}
  .top{min-height:68px;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:12px 0;border-bottom:1px solid var(--line)}
  .back,.submit{display:flex;align-items:center;min-height:44px;color:var(--muted);font-size:12px;text-decoration:none}
  .back{gap:8px}
  .back:first-letter{color:var(--orange)}
  .submit{flex:0 0 auto;color:var(--ink)}
  .submit span{color:var(--orange)}
  .crumb{margin:36px 0 9px;color:var(--muted);font-size:11px;overflow-wrap:anywhere}
  .crumb span{padding:0 5px;color:var(--orange)}
  h1{margin:0;font-size:32px;letter-spacing:0;overflow-wrap:anywhere}
  .lead{max-width:680px;margin:10px 0 30px;color:var(--muted);font-size:14px;line-height:1.8;overflow-wrap:anywhere}
  .columns{display:grid;grid-template-columns:minmax(0,1fr) 245px;gap:44px}
  .columns article{min-width:0}
  .columns article>section{padding:20px 0;border-top:1px solid var(--line)}
  h2{margin:0 0 13px;font-size:14px;font-weight:650;overflow-wrap:anywhere}
  article section>p,.prose{color:var(--ink);font-size:13px;line-height:1.9;overflow-wrap:anywhere}
  .number{display:inline-grid;place-items:center;width:19px;height:19px;margin-left:4px;border-radius:50%;background:color-mix(in srgb,var(--orange) 14%,transparent);color:var(--orange);font-size:10px}
  .foods{display:grid;gap:0;margin:0;padding:0;list-style:none}
  .foods li{padding:11px 0;border-bottom:1px solid var(--line);overflow-wrap:anywhere}
  .foods li:last-child{border:0}
  .foods strong{font-size:13px;font-weight:600}
  .food-location{margin-left:9px;color:var(--green);font-size:11px}
  .foods p{margin:5px 0 0;color:var(--muted);font-size:12px;line-height:1.7;overflow-wrap:anywhere}
  .foods small{display:block;margin-top:5px;color:var(--orange);font-size:11px;overflow-wrap:anywhere}
  .reviews{display:grid;gap:10px}
  .reviews blockquote{margin:0;padding:14px 15px;border-left:2px solid #d88865;background:color-mix(in srgb,var(--ink) 2%,transparent);overflow-wrap:anywhere}
  .reviews blockquote p{margin:0;color:var(--ink);font-size:13px;line-height:1.8;overflow-wrap:anywhere}
  .reviews footer{padding:9px 0 0;margin:8px 0 0;border-top:1px solid var(--line);color:var(--muted);font-size:11px;overflow-wrap:anywhere}
  .reviews footer span{display:block;margin-top:4px;font-size:10px;overflow-wrap:anywhere}
  .muted,.source-note{color:var(--muted);font-size:12px;line-height:1.8;overflow-wrap:anywhere}
  .prose :global(p){margin:0}
  .prose :global(a){color:var(--orange);overflow-wrap:anywhere}
  .prose :global(code){font-family:ui-monospace,monospace;word-break:break-word}
  .prose :global(img){display:block;max-width:100%;height:auto;margin:12px 0;border-radius:7px}
  article figure{margin:20px 0}
  article figure img{display:block;width:auto;max-width:100%;height:auto;border-radius:7px}
  figcaption{margin-top:7px;color:var(--muted);font-size:11px;overflow-wrap:anywhere}
  aside{align-self:start;min-width:0;padding:18px;border:1px solid var(--line);border-radius:8px;background:color-mix(in srgb,var(--ink) 1.7%,transparent)}
  aside h2{padding-bottom:13px;border-bottom:1px solid var(--line)}
  dl{display:grid;gap:7px;margin:0}
  dt{margin-top:6px;color:var(--muted);font-size:10px}
  dd{margin:0;font-size:12px;line-height:1.7;overflow-wrap:anywhere}
  .map{display:flex;align-items:center;justify-content:space-between;min-height:44px;padding:0;margin-top:15px;border-top:1px solid var(--line);color:var(--orange);font-size:12px;text-decoration:none}
  .source-note{padding-top:12px;margin:0;border-top:1px solid var(--line);font-size:10px}
  .sources{padding:16px 0;margin-top:25px;border-top:1px solid var(--line);font-size:12px}
  .sources summary{min-height:44px;display:flex;align-items:center;cursor:pointer;color:var(--muted)}
  .sources ul{padding-left:18px;color:var(--muted);line-height:1.8;overflow-wrap:anywhere}
  @media(max-width:820px){.columns{grid-template-columns:minmax(0,1fr) 220px;gap:24px}}
  @media(max-width:640px){
    .detail-page{padding:0 18px 40px}
    .top{align-items:flex-start}
    .columns{grid-template-columns:1fr;gap:10px}
    .columns aside{grid-row:1}
    h1{font-size:27px}
    .crumb{margin-top:27px}
    aside{padding:15px}
  }
  @media(max-width:360px){.detail-page{padding-right:16px;padding-left:16px}.top{gap:8px}.back,.submit{font-size:11px}}
</style>
