---
import { getCollection } from 'astro:content';
import Layout from '../../templates/Layout.astro';
import QuickReview from '../../components/QuickReview.astro';
import RatingDisplay from '../../components/RatingDisplay.astro';
import { deriveDistanceTags } from '../../lib/catalog';
import { formatLocation, formatPrice, kindLabel, licenseLink, mealLabel, safePublicImage, safePublicLink, tagLabel } from '../../utils/catalog-display';

export const prerender = true;

export async function getStaticPaths() {
  const [venueEntries, foodEntries, reviewEntries] = await Promise.all([
    getCollection('restaurants'),
    getCollection('foods'),
    getCollection('reviews'),
  ]);
  return venueEntries.map(({ id, data: restaurant }) => ({
    params: { id },
    props: {
      restaurant: { ...restaurant, tags: deriveDistanceTags(restaurant) },
      foods: foodEntries.filter(({ data: food }) => food.venueId === id).map(({ data: food }) => food),
      reviews: reviewEntries.filter(({ data: review }) => review.targetType === 'venue' && review.targetId === id).map(({ data: review }) => review),
    },
  }));
}

const { restaurant, foods, reviews } = Astro.props;
const categoryLabel = restaurant.category === 'on-campus' ? '校内' : '校外';
const location = formatLocation(restaurant.location);
const coordinates = restaurant.location.coordinates;
const heroImage = safePublicImage(restaurant.images?.[0]);
const heroSourceUrl = heroImage ? safePublicLink(heroImage.sourceUrl) : null;
const publicReviewImages = reviews.flatMap((review) => (review.images ?? [])
  .flatMap((candidate) => {
    const image = safePublicImage(candidate);
    return image ? [image] : [];
  }));
---

<Layout title={restaurant.name}>
  <main class="detail-page">
    <header class="top">
      <a href="/restaurants/" class="back"><span aria-hidden="true">←</span> <span>返回目录</span></a>
      <a class="submit" href="#review-form">评价这家店 <span aria-hidden="true">↗</span></a>
    </header>

    <section class="hero" aria-labelledby="venue-title">
      <div class="hero-copy">
        <p class="crumb"><span>{categoryLabel}</span><i aria-hidden="true">·</i>{kindLabel(restaurant.kind)}</p>
        <h1 id="venue-title">{restaurant.name}</h1>
        <p class="lead"><span aria-hidden="true">⌖</span> {location}</p>
        <div class="hero-meta">
          <span>{restaurant.tags?.map(tagLabel).find((tag: string) => tag !== '校内' && tag !== '校外') ?? kindLabel(restaurant.kind)}</span>
          <span>{foods.length} 个餐品</span>
          <span>{reviews.length} 条评价</span>
        </div>
      </div>
      <div class="hero-image">
        {heroImage ? <img src={heroImage.url} alt={heroImage.alt} /> : <div class="photo-placeholder" role="img" aria-label="暂无图片"><svg viewBox="0 0 120 90" aria-hidden="true"><path d="M20 64c0-20 18-37 40-37s40 17 40 37" /><path d="M13 65h94M33 65v10h54V65M40 27l7-13h26l7 13" /><circle cx="60" cy="42" r="8" /></svg><span>暂无图片</span></div>}
      </div>
      {heroImage && <p class="image-credit">{heroImage.isIllustrative ? '示意图' : '图片'}{heroImage.author && <> · {heroImage.author}</>}{heroSourceUrl && <> · <a href={heroSourceUrl} target="_blank" rel="noreferrer">来源页</a></>}{heroImage.license && <> · {licenseLink(heroImage.license) ? <a href={licenseLink(heroImage.license)!} target="_blank" rel="noreferrer">{heroImage.license}</a> : heroImage.license}</>}</p>}
    </section>

    <div class="columns">
      <article>
        <section class="summary-card">
          <div><p class="section-kicker">ABOUT THIS PLACE</p><h2>先看看这里</h2></div>
          <p class="description">{restaurant.description ?? '暂未补充详细介绍。'}</p>
          <div class="quick-facts">
            <div><span>消费范围</span><strong>{formatPrice(restaurant.averagePrice)}</strong></div>
            <div><span>营业信息</span><strong>{restaurant.openingHours ?? '营业时间待补充'}</strong></div>
          </div>
        </section>

        <section class="section-block">
          <div class="section-heading"><div><p class="section-kicker">MENU NOTES</p><h2>餐品与档口</h2></div><div class="section-heading-actions"><span class="section-count">{foods.length}</span><a class="section-action" href={'/submit/?venueEntityId=' + restaurant.id}>添加餐品 <span aria-hidden="true">＋</span></a></div></div>
          {foods.length ? <div class="foods">
            {foods.map((food) => {
              const image = safePublicImage(food.images?.[0]);
              return <a class="food-card" href={'/foods/' + food.id + '/'}>
                <div class="food-image">
                  {image ? <img src={image.url} alt={image.alt} loading="lazy" referrerpolicy="no-referrer" /> : <div class="mini-placeholder" role="img" aria-label="暂无图片"><span aria-hidden="true">✦</span><small>暂无图片</small></div>}
                </div>
                <div class="food-card-body"><div class="food-title"><h3>{food.name}</h3><span aria-hidden="true">↗</span></div><p>{food.description ?? '餐品描述待补充。'}</p><div class="food-meta"><span>{formatPrice(food.price)}</span><span>{food.mealTypes?.map(mealLabel).join(' · ') || '餐段待补充'}</span></div></div>
              </a>;
            })}
          </div> : <div class="empty-state"><span aria-hidden="true">✦</span><p>目前还没有餐品。</p><a href={'/submit/?venueEntityId=' + restaurant.id}>添加餐品 <span aria-hidden="true">→</span></a></div>}
        </section>

        <section class="section-block">
          <div class="section-heading"><div><p class="section-kicker">STUDENT NOTES</p><h2>同学评价</h2></div><span class="section-count">{reviews.length}</span></div>
          {reviews.length ? <div class="reviews">
            {reviews.map((review) => {
              const reviewImages = (review.images ?? [])
                .flatMap((candidate) => {
                  const image = safePublicImage(candidate);
                  return image ? [image] : [];
                });
              return <blockquote>
              <div class="review-top"><RatingDisplay rating={review.rating} /><time>{review.visitedAt ?? '日期待补充'}</time></div>
              <p>{review.text}</p>
              {reviewImages.length > 0 && <div class="review-images" aria-label="评价图片">
                {reviewImages.map((reviewImage, index) => {
                  const sourceUrl = safePublicLink(reviewImage.sourceUrl);
                  const imageLicenseUrl = licenseLink(reviewImage.license);
                  return <figure class="review-image">
                    <a class="review-image-link" href={reviewImage.url} target="_blank" rel="noreferrer" aria-label={'查看评价图片 ' + (index + 1) + ' 原图'}><img src={reviewImage.url} alt={reviewImage.alt} loading="lazy" referrerpolicy="no-referrer" /></a>
                    <figcaption>{reviewImage.isIllustrative && <span>示意图</span>}{reviewImage.author && <span> · {reviewImage.author}</span>}{sourceUrl && <span> · <a href={sourceUrl} target="_blank" rel="noreferrer">来源页</a></span>}{reviewImage.license && <span> · {imageLicenseUrl ? <a href={imageLicenseUrl} target="_blank" rel="noreferrer">{reviewImage.license}</a> : reviewImage.license}</span>}</figcaption>
                  </figure>;
                })}
              </div>}
              <footer>{review.authorAlias ?? '匿名同学'}</footer>
            </blockquote>;
            })}
          </div> : <div class="empty-state"><span aria-hidden="true">✦</span><p>目前还没有同学评价。</p><a href="#review-form">评价这家店 <span aria-hidden="true">→</span></a></div>}
        </section>

        {restaurant.images.slice(1).map((image) => {
          const publicImage = safePublicImage(image);
          const imageLicenseUrl = publicImage ? licenseLink(publicImage.license) : null;
          return publicImage && <figure><img src={publicImage.url} alt={publicImage.alt} loading="lazy" referrerpolicy="no-referrer" /><figcaption>{publicImage.alt}{publicImage.isIllustrative && <span> · 示意图</span>}{publicImage.author && <span> · {publicImage.author}</span>}{publicImage.license && <span> · {imageLicenseUrl ? <a href={imageLicenseUrl} target="_blank" rel="noreferrer">{publicImage.license}</a> : publicImage.license}</span>}</figcaption></figure>;
        })}
        <QuickReview targetType="venue" targetId={restaurant.id} targetName={restaurant.name} />
      </article>

      <aside class="info-card">
        <div class="info-card-heading"><span class="round-icon" aria-hidden="true">⌖</span><h2>店铺信息</h2></div>
        <dl>
          <dt>位置</dt><dd>{location}</dd>
          <dt>分类</dt><dd>{categoryLabel} · {kindLabel(restaurant.kind)}</dd>
          <dt>最近更新</dt><dd>{restaurant.dates.updatedAt ?? '日期待补充'}</dd>
        </dl>
        {coordinates && <a class="map" href={'https://www.openstreetmap.org/?mlat=' + coordinates[0] + '&mlon=' + coordinates[1] + '#map=17/' + coordinates[0] + '/' + coordinates[1]} target="_blank" rel="noreferrer">在地图中查看 <span aria-hidden="true">↗</span></a>}
        <p class="source-note">评价是个人体验。位置、价格与营业信息可能变化，建议到店前核对。</p>
        <a class="aside-submit" href="#review-form">评价这家店 <span aria-hidden="true">＋</span></a>
      </aside>
    </div>

    {(restaurant.sources.length > 0 || restaurant.images.length > 0 || publicReviewImages.length > 0) && <details class="sources"><summary>信息来源 <span aria-hidden="true">＋</span></summary><ul>
      {restaurant.sources.map((source: { repository: string; path: string; license: string | null; sourceUrl?: string | null }) => { const sourceUrl = safePublicLink(source.sourceUrl); const sourceLicenseUrl = licenseLink(source.license); return <li>{source.repository} · {source.path} · {sourceUrl ? <a href={sourceUrl} target="_blank" rel="noreferrer">来源页</a> : '来源页待补充'} · {source.license ? (sourceLicenseUrl ? <a href={sourceLicenseUrl} target="_blank" rel="noreferrer">{source.license}</a> : source.license) : '授权状态待确认'}</li>; })}
      {heroImage && <li>主图{heroImage.isIllustrative && <> · 示意图</>}{heroImage.author && <> · 作者：{heroImage.author}</>}{heroSourceUrl && <> · <a href={heroSourceUrl} target="_blank" rel="noreferrer">来源页</a></>}{heroImage.license && <> · 许可：{licenseLink(heroImage.license) ? <a href={licenseLink(heroImage.license)!} target="_blank" rel="noreferrer">{heroImage.license}</a> : heroImage.license}</>}{heroImage.sourceNote && <> · 备注：{heroImage.sourceNote}</>}</li>}
      {restaurant.images.slice(1).map((image, index) => { const publicImage = safePublicImage(image); const sourceUrl = publicImage ? safePublicLink(publicImage.sourceUrl) : null; const imageLicenseUrl = publicImage ? licenseLink(publicImage.license) : null; return publicImage && <li>图片 {index + 2}{publicImage.isIllustrative && <> · 示意图</>}{publicImage.author && <> · 作者：{publicImage.author}</>}{sourceUrl && <> · <a href={sourceUrl} target="_blank" rel="noreferrer">来源页</a></>}{publicImage.license && <> · 许可：{imageLicenseUrl ? <a href={imageLicenseUrl} target="_blank" rel="noreferrer">{publicImage.license}</a> : publicImage.license}</>}{publicImage.sourceNote && <> · 备注：{publicImage.sourceNote}</>}</li>; })}
      {publicReviewImages.map((reviewImage, index) => { const sourceUrl = safePublicLink(reviewImage.sourceUrl); const imageLicenseUrl = licenseLink(reviewImage.license); return <li>评价图片 {index + 1}{reviewImage.isIllustrative && <> · 示意图</>}{reviewImage.author && <> · 作者：{reviewImage.author}</>}{sourceUrl && <> · <a href={sourceUrl} target="_blank" rel="noreferrer">来源页</a></>}{reviewImage.license && <> · 许可：{imageLicenseUrl ? <a href={imageLicenseUrl} target="_blank" rel="noreferrer">{reviewImage.license}</a> : reviewImage.license}</>}{reviewImage.sourceNote && <> · 备注：{reviewImage.sourceNote}</>}</li>; })}
    </ul></details>}
  </main>
</Layout>

<style>
  .detail-page{width:calc(100% - clamp(32px,4vw,96px));margin:auto;padding:0 0 60px}
  .top{min-height:84px;display:flex;justify-content:space-between;align-items:center;gap:16px;border-bottom:1px solid var(--line)}
  .back,.submit{display:flex;align-items:center;min-height:44px;color:var(--muted);font-size:12px;text-decoration:none}
  .back{gap:8px}.back span:first-child,.submit span{color:var(--orange)}
  .submit{flex:0 0 auto;color:var(--ink);font-weight:700}
  .hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,420px);grid-template-areas:'copy image' 'copy credit';align-items:start;column-gap:60px;row-gap:0;padding:62px 0 56px}
  .hero-copy{grid-area:copy;align-self:center;min-width:0}
  .crumb{display:flex;align-items:center;gap:10px;margin:0 0 14px;color:var(--muted);font-size:12px;font-weight:700}
  .crumb span{color:var(--orange-deep)}.crumb i{color:var(--honey);font-style:normal}
  h1{margin:0;color:var(--ink);font-size:clamp(38px,5vw,64px);line-height:1.05;letter-spacing:-.05em;overflow-wrap:anywhere}
  .lead{display:flex;gap:8px;max-width:620px;margin:18px 0 20px;color:var(--muted);font-size:15px;line-height:1.8;overflow-wrap:anywhere}
  .lead span{color:var(--orange)}
  .hero-meta{display:flex;flex-wrap:wrap;gap:8px}
  .hero-meta span{padding:8px 12px;border-radius:999px;background:var(--surface-card);box-shadow:var(--shadow-card);color:var(--muted);font-size:11px;font-weight:700}
  .hero-meta span:first-child{background:#fff2eb;color:var(--orange-deep)}
  .hero-image{grid-area:image;position:relative;overflow:hidden;aspect-ratio:16/10;border-radius:32px;background:#f5eee7;box-shadow:var(--shadow-hover)}
  .hero-image>img{display:block;width:100%;height:100%;object-fit:cover}.image-credit{grid-area:credit;margin:9px 0 0;color:var(--muted);font-size:10px;line-height:1.7;overflow-wrap:anywhere}.image-credit a,figcaption a,.sources a{color:var(--orange-deep);text-decoration:underline;text-underline-offset:2px}
  .photo-placeholder{display:grid;width:100%;height:100%;place-items:center;align-content:center;gap:8px;background:radial-gradient(circle at 55% 25%,#fffdf9 0 6%,transparent 7%),linear-gradient(135deg,#fff7f0,#f4e6db);color:#b89a8d;font-size:12px;font-weight:800}
  .photo-placeholder svg{width:120px;height:90px;fill:none;stroke:#d3ad9b;stroke-linecap:round;stroke-linejoin:round;stroke-width:2}
  .columns{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,26%);gap:40px;align-items:start}
  .columns article{min-width:0}
  .summary-card{padding:25px;border-radius:28px;background:var(--ink);color:#fff;box-shadow:var(--shadow-hover)}
  .summary-card .section-kicker{color:#ffb69f}
  .summary-card h2{margin:8px 0 12px;color:#fff}
  .section-kicker{margin:0;color:var(--orange-deep);font-size:10px;font-weight:800;letter-spacing:.14em}
  h2{margin:7px 0 14px;color:var(--ink);font-size:24px;line-height:1.2;letter-spacing:-.03em}
  .description{margin:0;color:#f7eee9;font-size:14px;line-height:1.8;overflow-wrap:anywhere}
  .quick-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:22px}
  .quick-facts div{min-width:0;padding:14px;border-radius:17px;background:rgba(255,255,255,.1)}
  .quick-facts span,.quick-facts strong{display:block;overflow-wrap:anywhere}.quick-facts span{color:#d7c6bf;font-size:10px}.quick-facts strong{margin-top:7px;color:#fff;font-size:13px;line-height:1.5}
  .section-block{padding:38px 0 0}
  .section-heading{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:17px}
  .section-heading h2{margin:7px 0 0}.section-heading-actions{display:flex;align-items:center;justify-content:flex-end;gap:9px;flex-wrap:wrap}.section-count{display:grid;min-width:30px;min-height:30px;place-items:center;border-radius:50%;background:#fff2eb;color:var(--orange-deep);font-size:12px;font-weight:800}.section-action{display:inline-flex;align-items:center;gap:5px;min-height:44px;padding:0 12px;border-radius:13px;background:#e4f6ea;color:var(--green);font-size:11px;font-weight:800;text-decoration:none;white-space:nowrap}
  .foods{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  .food-card{display:flex;min-width:0;overflow:hidden;border:1px solid rgba(45,49,66,.07);border-radius:22px;background:var(--surface-card);box-shadow:var(--shadow-card);text-decoration:none;transition:transform .2s,box-shadow .2s}
  .food-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-hover)}
  .food-image{flex:0 0 112px;min-height:124px;background:#f5eee7}.food-image img{display:block;width:100%;height:100%;object-fit:cover}
  .mini-placeholder{display:grid;height:100%;place-items:center;align-content:center;gap:5px;color:#c39a8b}.mini-placeholder span{font-size:22px}.mini-placeholder small{font-size:9px;font-weight:700}
  .food-card-body{min-width:0;padding:14px}
  .food-title{display:flex;align-items:start;justify-content:space-between;gap:6px}.food-title h3{min-width:0;margin:0;color:var(--ink);font-size:15px;line-height:1.4;overflow-wrap:anywhere}.food-title span{color:var(--orange);font-size:15px}
  .food-card-body p{display:-webkit-box;overflow:hidden;margin:6px 0 11px;color:var(--muted);font-size:11px;line-height:1.6;overflow-wrap:anywhere;-webkit-box-orient:vertical;-webkit-line-clamp:2}
  .food-meta{display:flex;flex-wrap:wrap;gap:5px;color:var(--orange-deep);font-size:10px;font-weight:800}.food-meta span+span{color:var(--muted)}
  .review-images{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr));gap:10px;margin:13px 0 14px}.review-image{min-width:0;margin:0}.review-image-link{display:block;overflow:hidden;border-radius:16px;background:#f5eee7}.review-image-link img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;transition:transform .2s ease}.review-image-link:hover img,.review-image-link:focus-visible img{transform:scale(1.02)}.review-image figcaption{margin-top:7px;color:var(--muted);font-size:10px;line-height:1.6;overflow-wrap:anywhere}.review-image figcaption a{color:var(--orange-deep);text-decoration:underline;text-underline-offset:2px}.reviews{display:grid;gap:12px}.reviews blockquote{margin:0;padding:18px 20px;border:1px solid var(--line);border-radius:20px;background:var(--surface-card);box-shadow:var(--shadow-card)}
  .review-top{display:flex;align-items:center;justify-content:space-between;gap:12px}.review-top time{color:var(--muted);font-size:10px;overflow-wrap:anywhere}
  .unrated{color:var(--muted);font-size:11px;font-weight:700}.reviews blockquote p{margin:13px 0;color:var(--ink);font-size:13px;line-height:1.85;overflow-wrap:anywhere}.reviews footer{padding-top:11px;border-top:1px solid var(--line);color:var(--muted);font-size:11px}
  .empty-state{display:grid;justify-items:start;gap:8px;padding:24px;border:1px dashed #e1d5cc;border-radius:22px;color:var(--muted)}.empty-state>span{color:var(--honey);font-size:23px}.empty-state p{margin:0;font-size:13px}.empty-state a{display:flex;align-items:center;min-height:44px;color:var(--orange-deep);font-size:12px;font-weight:800}
  .prose-section{border-top:1px solid var(--line)}.prose{color:var(--ink);font-size:13px;line-height:1.9;overflow-wrap:anywhere}.prose :global(p){margin:0}.prose :global(a){color:var(--orange);overflow-wrap:anywhere}.prose :global(code){font-family:ui-monospace,monospace;word-break:break-word}
  article figure{margin:25px 0}article figure img{display:block;max-width:100%;height:auto;border-radius:22px}figcaption{margin-top:8px;color:var(--muted);font-size:11px;overflow-wrap:anywhere}
  .info-card{position:sticky;top:24px;min-width:0;padding:23px;border:1px solid rgba(255,107,53,.1);border-radius:28px;background:var(--surface-card);box-shadow:var(--shadow-card)}
  .info-card-heading{display:flex;align-items:center;gap:10px;padding-bottom:16px;border-bottom:1px solid var(--line)}.info-card-heading h2{margin:0;font-size:19px}.round-icon{display:grid;width:34px;height:34px;place-items:center;border-radius:12px;background:#fff2eb;color:var(--orange-deep);font-size:18px}
  dl{display:grid;gap:7px;margin:19px 0 0}dt{margin-top:8px;color:var(--muted);font-size:10px;font-weight:700}dd{margin:0;color:var(--ink);font-size:12px;line-height:1.7;overflow-wrap:anywhere}
  .map,.aside-submit{display:flex;align-items:center;justify-content:space-between;min-height:48px;margin-top:18px;padding:0 14px;border-radius:15px;background:#fff2eb;color:var(--orange-deep);font-size:12px;font-weight:800;text-decoration:none}.map{border-top:0}.aside-submit{margin-top:10px;background:var(--orange);color:#fff}
  .source-note{padding-top:16px;margin:17px 0 0;border-top:1px solid var(--line);color:var(--muted);font-size:10px;line-height:1.8;overflow-wrap:anywhere}
  .sources{padding:18px 0;margin-top:34px;border-top:1px solid var(--line);font-size:12px}.sources summary{display:flex;align-items:center;justify-content:space-between;min-height:44px;color:var(--muted);font-weight:700;cursor:pointer}.sources ul{padding-left:18px;color:var(--muted);line-height:1.8;overflow-wrap:anywhere}.sources li{margin:8px 0}
  @media(max-width:980px){.hero{grid-template-columns:minmax(0,1fr) minmax(260px,36vw);column-gap:32px;row-gap:0}.columns{grid-template-columns:minmax(0,1fr) 260px;gap:25px}.foods{grid-template-columns:1fr}}
  @media(max-width:700px){.detail-page{width:calc(100% - clamp(32px,4vw,96px));padding-bottom:40px}.top{min-height:72px}.hero{grid-template-columns:1fr;grid-template-areas:'image' 'credit' 'copy';align-items:start;column-gap:0;row-gap:0;padding:40px 0 35px}.hero-image{aspect-ratio:16/9;border-radius:25px}.hero-copy{align-self:start;margin-top:27px}.columns{grid-template-columns:1fr;gap:0}.info-card{position:static;grid-row:1;margin-bottom:24px}.summary-card{padding:21px;border-radius:24px}.section-block{padding-top:31px}}
  @media(max-width:520px){h1{font-size:38px}.lead{font-size:14px}.quick-facts{grid-template-columns:1fr}.foods{grid-template-columns:1fr}.food-image{flex-basis:105px}.reviews blockquote{padding:16px}.review-top{align-items:flex-start;flex-direction:column;gap:5px}.hero-meta span{font-size:10px}.submit,.back{font-size:11px}}
  @media(max-width:360px){.detail-page{width:calc(100% - 32px)}.top{gap:8px}.back,.submit{font-size:10px}.hero{padding-top:32px}.summary-card{padding:18px}}
</style>
