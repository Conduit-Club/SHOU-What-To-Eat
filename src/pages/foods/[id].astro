---
import { getCollection } from 'astro:content';
import Layout from '../../templates/Layout.astro';
import QuickReview from '../../components/QuickReview.astro';
import RatingDisplay from '../../components/RatingDisplay.astro';
import { formatLocation, formatPrice, licenseLink, mealLabel, safePublicImage, safePublicLink, tagLabel } from '../../utils/catalog-display';

export const prerender = true;

export async function getStaticPaths() {
  const [foodEntries, venueEntries, reviewEntries] = await Promise.all([
    getCollection('foods'),
    getCollection('restaurants'),
    getCollection('reviews'),
  ]);
  return foodEntries.map(({ id, data: food }) => ({
    params: { id },
    props: {
      food,
      venue: venueEntries.find(({ id: venueId }) => venueId === food.venueId)?.data ?? null,
      reviews: reviewEntries.filter(({ data: review }) => review.targetType === 'food' && review.targetId === id).map(({ data: review }) => review),
    },
  }));
}

const { food, venue, reviews } = Astro.props;
const image = safePublicImage(food.images?.[0]);
const imageSourceUrl = image ? safePublicLink(image.sourceUrl) : null;
const foodGalleryImages = (food.images ?? [])
  .slice(1)
  .flatMap((candidate) => {
    const image = safePublicImage(candidate);
    return image ? [image] : [];
  });
const publicReviewImages = reviews.flatMap((review) => (review.images ?? [])
  .flatMap((candidate) => {
    const image = safePublicImage(candidate);
    return image ? [image] : [];
  }));
---

<Layout title={food.name}>
  <main class="food-page">
    <header class="top">
      <a href="/" class="back"><span aria-hidden="true">←</span> 返回餐品食单</a>
      <a class="submit" href="#review-form">评价这道餐品 <span aria-hidden="true">↗</span></a>
    </header>
    <section class="food-hero" aria-labelledby="food-title">
      <div class="hero-image">
        {image ? <img src={image.url} alt={image.alt} /> : <div class="photo-placeholder" role="img" aria-label="暂无图片"><svg viewBox="0 0 120 90" aria-hidden="true"><path d="M21 63c10-26 68-26 78 0" /><path d="M13 65h94M34 65v10h52V65M43 35h34" /><circle cx="60" cy="31" r="12" /></svg><span>暂无图片</span></div>}
      </div>
      {image && <p class="image-credit">{image.isIllustrative ? '示意图' : '图片'}{image.author && <> · {image.author}</>}{imageSourceUrl && <> · <a href={imageSourceUrl} target="_blank" rel="noreferrer">来源页</a></>}{image.license && <> · {licenseLink(image.license) ? <a href={licenseLink(image.license)!} target="_blank" rel="noreferrer">{image.license}</a> : image.license}</>}</p>}
      <div class="hero-copy">
        <p class="crumb"><span>{venue?.category === 'on-campus' ? '校内' : '校外'}</span><i aria-hidden="true">·</i>{mealLabel(food.mealTypes?.[0])}</p>
        <h1 id="food-title">{food.name}</h1>
        {venue && <a class="venue-link" href={'/restaurants/' + venue.id + '/'}>{venue.name} · {formatLocation(venue.location)} <span aria-hidden="true">↗</span></a>}
        <p class="price">{formatPrice(food.price)}</p>
        <div class="tags">{food.mealTypes?.map(mealLabel).concat(food.tags ?? []).map((tag: string) => <span>{tagLabel(tag)}</span>)}</div>
      </div>
    </section>
    <div class="columns">
      <article>
        <section class="content-card"><p class="section-kicker">ABOUT THIS DISH</p><h2>餐品信息</h2><p class="description">{food.description ?? '暂未补充餐品描述。'}</p></section>
        {foodGalleryImages.length > 0 && <section class="section-block image-gallery-block" aria-labelledby="food-images-heading">
          <div class="section-heading"><div><p class="section-kicker">MORE PHOTOS</p><h2 id="food-images-heading">更多餐品照片</h2></div><span class="section-count">{foodGalleryImages.length}</span></div>
          <div class="image-gallery">
            {foodGalleryImages.map((galleryImage, index) => {
              const sourceUrl = safePublicLink(galleryImage.sourceUrl);
              const imageLicenseUrl = licenseLink(galleryImage.license);
              return <figure class="gallery-item">
                <a class="gallery-image-link" href={galleryImage.url} target="_blank" rel="noreferrer" aria-label={'查看第 ' + (index + 2) + ' 张餐品图片原图'}><img src={galleryImage.url} alt={galleryImage.alt} loading="lazy" referrerpolicy="no-referrer" /></a>
                <figcaption>{galleryImage.isIllustrative && <span>示意图</span>}{galleryImage.author && <span> · {galleryImage.author}</span>}{sourceUrl && <span> · <a href={sourceUrl} target="_blank" rel="noreferrer">来源页</a></span>}{galleryImage.license && <span> · {imageLicenseUrl ? <a href={imageLicenseUrl} target="_blank" rel="noreferrer">{galleryImage.license}</a> : galleryImage.license}</span>}</figcaption>
              </figure>;
            })}
          </div>
        </section>}
        <section class="section-block">
          <div class="section-heading"><div><p class="section-kicker">STUDENT NOTES</p><h2>同学评价</h2></div><span class="section-count">{reviews.length}</span></div>
          {reviews.length ? <div class="reviews">{reviews.map((review) => {
            const reviewImages = (review.images ?? [])
              .flatMap((candidate) => {
                const image = safePublicImage(candidate);
                return image ? [image] : [];
              });
            return <blockquote>
              <div class="review-top"><RatingDisplay rating={review.rating} /><time>{review.visitedAt ?? '日期待补充'}</time></div>
              <p>{review.text}</p>
              {reviewImages.length > 0 && <div class="review-images" aria-label="评价图片">
                {reviewImages.map((reviewImage, index) => {
                  const sourceUrl = safePublicLink(reviewImage.sourceUrl);
                  const imageLicenseUrl = licenseLink(reviewImage.license);
                  return <figure class="review-image">
                    <a class="review-image-link" href={reviewImage.url} target="_blank" rel="noreferrer" aria-label={'查看评价图片 ' + (index + 1) + ' 原图'}><img src={reviewImage.url} alt={reviewImage.alt} loading="lazy" referrerpolicy="no-referrer" /></a>
                    <figcaption>{reviewImage.isIllustrative && <span>示意图</span>}{reviewImage.author && <span> · {reviewImage.author}</span>}{sourceUrl && <span> · <a href={sourceUrl} target="_blank" rel="noreferrer">来源页</a></span>}{reviewImage.license && <span> · {imageLicenseUrl ? <a href={imageLicenseUrl} target="_blank" rel="noreferrer">{reviewImage.license}</a> : reviewImage.license}</span>}</figcaption>
                  </figure>;
                })}
              </div>}
              <footer>{review.authorAlias ?? '匿名同学'}</footer>
            </blockquote>;
          })}</div> : <div class="empty-state"><span aria-hidden="true">✦</span><p>目前还没有同学评价。</p><a href="#review-form">评价这道餐品 <span aria-hidden="true">→</span></a></div>}
        </section>
        <QuickReview targetType="food" targetId={food.id} targetName={food.name} />
      </article>
      <aside class="info-card">
        <div class="info-card-heading"><span class="round-icon" aria-hidden="true">✦</span><h2>餐品信息</h2></div>
        <dl><dt>所属店铺</dt><dd>{venue ? venue.name : '待关联'}</dd><dt>餐段</dt><dd>{food.mealTypes?.map(mealLabel).join(' · ') || '餐段待补充'}</dd><dt>最近更新</dt><dd>{food.dates.updatedAt ?? '日期待补充'}</dd></dl>
        {venue && <a class="aside-submit" href="#review-form">评价这道餐品 <span aria-hidden="true">＋</span></a>}
      </aside>
    </div>
    {(food.sources.length > 0 || image || foodGalleryImages.length > 0 || publicReviewImages.length > 0) && <details class="sources"><summary>信息来源 <span aria-hidden="true">＋</span></summary><ul>{food.sources.map((source: { repository: string; path: string; license: string | null; sourceUrl?: string | null }) => { const sourceUrl = safePublicLink(source.sourceUrl); const sourceLicenseUrl = licenseLink(source.license); return <li>{source.repository} · {source.path} · {sourceUrl ? <a href={sourceUrl} target="_blank" rel="noreferrer">来源页</a> : '来源页待补充'} · {source.license ? (sourceLicenseUrl ? <a href={sourceLicenseUrl} target="_blank" rel="noreferrer">{source.license}</a> : source.license) : '授权状态待确认'}</li>; })}{image && <li>主图{image.isIllustrative && <> · 示意图</>}{image.author && <> · 作者：{image.author}</>}{imageSourceUrl && <> · <a href={imageSourceUrl} target="_blank" rel="noreferrer">来源页</a></>}{image.license && <> · 许可：{licenseLink(image.license) ? <a href={licenseLink(image.license)!} target="_blank" rel="noreferrer">{image.license}</a> : image.license}</>}{image.sourceNote && <> · 备注：{image.sourceNote}</>}</li>}{foodGalleryImages.map((galleryImage, index) => { const sourceUrl = safePublicLink(galleryImage.sourceUrl); const imageLicenseUrl = licenseLink(galleryImage.license); return <li>图片 {index + 2}{galleryImage.isIllustrative && <> · 示意图</>}{galleryImage.author && <> · 作者：{galleryImage.author}</>}{sourceUrl && <> · <a href={sourceUrl} target="_blank" rel="noreferrer">来源页</a></>}{galleryImage.license && <> · 许可：{imageLicenseUrl ? <a href={imageLicenseUrl} target="_blank" rel="noreferrer">{galleryImage.license}</a> : galleryImage.license}</>}{galleryImage.sourceNote && <> · 备注：{galleryImage.sourceNote}</>}</li>; })}{publicReviewImages.map((reviewImage, index) => { const sourceUrl = safePublicLink(reviewImage.sourceUrl); const imageLicenseUrl = licenseLink(reviewImage.license); return <li>评价图片 {index + 1}{reviewImage.isIllustrative && <> · 示意图</>}{reviewImage.author && <> · 作者：{reviewImage.author}</>}{sourceUrl && <> · <a href={sourceUrl} target="_blank" rel="noreferrer">来源页</a></>}{reviewImage.license && <> · 许可：{imageLicenseUrl ? <a href={imageLicenseUrl} target="_blank" rel="noreferrer">{reviewImage.license}</a> : reviewImage.license}</>}{reviewImage.sourceNote && <> · 备注：{reviewImage.sourceNote}</>}</li>; })}</ul></details>}
  </main>
</Layout>

<style>
  .food-page{width:calc(100% - clamp(32px,4vw,96px));margin:auto;padding:0 0 60px}
  .top{min-height:84px;display:flex;justify-content:space-between;align-items:center;gap:16px;border-bottom:1px solid var(--line)}
  .back,.submit{display:flex;align-items:center;min-height:44px;color:var(--muted);font-size:12px;text-decoration:none}.back{gap:8px}.back span:first-child,.submit span{color:var(--orange)}.submit{color:var(--ink);font-weight:700}
  .food-hero{display:grid;grid-template-columns:minmax(0,.42fr) minmax(0,.58fr);grid-template-areas:'image copy' 'credit copy';align-items:start;column-gap:54px;row-gap:0;padding:32px 0}
  .hero-image{grid-area:image;position:relative;overflow:hidden;aspect-ratio:16/10;max-height:380px;border-radius:28px;background:#f5eee7;box-shadow:var(--shadow-hover)}.hero-image>img{display:block;width:100%;height:100%;object-fit:cover}.image-credit{grid-area:credit;margin:9px 0 0;color:var(--muted);font-size:10px;line-height:1.7;overflow-wrap:anywhere}.image-credit a,.sources a{color:var(--orange-deep);text-decoration:underline;text-underline-offset:2px}
  .photo-placeholder{display:grid;width:100%;height:100%;place-items:center;align-content:center;gap:8px;background:radial-gradient(circle at 55% 25%,#fffdf9 0 6%,transparent 7%),linear-gradient(135deg,#fff7f0,#f4e6db);color:#b89a8d;font-size:12px;font-weight:800}.photo-placeholder svg{width:120px;height:90px;fill:none;stroke:#d3ad9b;stroke-linecap:round;stroke-linejoin:round;stroke-width:2}
  .hero-copy{grid-area:copy;align-self:center;min-width:0}.crumb{display:flex;gap:10px;margin:0 0 14px;color:var(--muted);font-size:12px;font-weight:700}.crumb span{color:var(--orange-deep)}.crumb i{color:var(--honey);font-style:normal}
  h1{margin:0;color:var(--ink);font-size:clamp(40px,5vw,64px);line-height:1.05;letter-spacing:-.05em;overflow-wrap:anywhere}.venue-link{display:block;margin-top:18px;color:var(--muted);font-size:13px;line-height:1.7;overflow-wrap:anywhere}.venue-link span{color:var(--orange)}
  .price{margin:18px 0;color:var(--orange-deep);font-size:20px;font-weight:800;overflow-wrap:anywhere}.tags{display:flex;flex-wrap:wrap;gap:8px}.tags span{padding:8px 11px;border-radius:999px;background:#f0fff4;color:#2e9d60;font-size:10px;font-weight:800}
  .columns{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,26%);gap:28px;align-items:start}.columns article{min-width:0}
  .content-card{padding:24px;border-radius:28px;background:var(--ink);color:#fff;box-shadow:var(--shadow-hover)}.content-card .section-kicker{color:#ffb69f}.content-card h2{margin:8px 0 12px;color:#fff}.section-kicker{margin:0;color:var(--orange-deep);font-size:10px;font-weight:800;letter-spacing:.14em}.description{margin:0;color:#f7eee9;font-size:14px;line-height:1.8;overflow-wrap:anywhere}
  .section-block{padding-top:38px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:17px}.section-heading h2{margin:7px 0 0;color:var(--ink);font-size:24px}.section-count{display:grid;min-width:30px;min-height:30px;place-items:center;border-radius:50%;background:#fff2eb;color:var(--orange-deep);font-size:12px;font-weight:800}
  .image-gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr));gap:12px}.gallery-item,.review-image{min-width:0;margin:0}.gallery-image-link,.review-image-link{display:block;overflow:hidden;border-radius:16px;background:#f5eee7}.gallery-image-link img,.review-image-link img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;transition:transform .2s ease}.gallery-image-link:hover img,.gallery-image-link:focus-visible img,.review-image-link:hover img,.review-image-link:focus-visible img{transform:scale(1.02)}.gallery-item figcaption,.review-image figcaption{margin-top:7px;color:var(--muted);font-size:10px;line-height:1.6;overflow-wrap:anywhere}.gallery-item figcaption a,.review-image figcaption a{color:var(--orange-deep);text-decoration:underline;text-underline-offset:2px}.review-images{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr));gap:10px;margin:13px 0 14px}.reviews{display:grid;gap:12px}.reviews blockquote{margin:0;padding:18px 20px;border:1px solid var(--line);border-radius:20px;background:var(--surface-card);box-shadow:var(--shadow-card)}.review-top{display:flex;align-items:center;justify-content:space-between;gap:12px}.unrated{color:var(--muted);font-size:11px;font-weight:700}.review-top time{color:var(--muted);font-size:10px}.reviews blockquote p{margin:13px 0;color:var(--ink);font-size:13px;line-height:1.85;overflow-wrap:anywhere}.reviews footer{padding-top:11px;border-top:1px solid var(--line);color:var(--muted);font-size:11px}
  .empty-state{display:grid;justify-items:start;gap:8px;padding:24px;border:1px dashed #e1d5cc;border-radius:22px;color:var(--muted)}.empty-state>span{color:var(--honey);font-size:23px}.empty-state p{margin:0;font-size:13px}.empty-state a{display:flex;align-items:center;min-height:44px;color:var(--orange-deep);font-size:12px;font-weight:800}
  .info-card{position:sticky;top:24px;min-width:0;padding:23px;border:1px solid rgba(255,107,53,.1);border-radius:28px;background:var(--surface-card);box-shadow:var(--shadow-card)}.info-card-heading{display:flex;align-items:center;gap:10px;padding-bottom:16px;border-bottom:1px solid var(--line)}.info-card-heading h2{margin:0;font-size:19px}.round-icon{display:grid;width:34px;height:34px;place-items:center;border-radius:12px;background:#fff2eb;color:var(--orange-deep)}
  dl{display:grid;gap:7px;margin:19px 0 0}dt{margin-top:8px;color:var(--muted);font-size:10px;font-weight:700}dd{margin:0;color:var(--ink);font-size:12px;line-height:1.7;overflow-wrap:anywhere}.aside-submit{display:flex;align-items:center;justify-content:space-between;min-height:48px;margin-top:20px;padding:0 14px;border-radius:15px;background:var(--orange);color:#fff;font-size:12px;font-weight:800;text-decoration:none}
  .sources{padding:18px 0;margin-top:34px;border-top:1px solid var(--line);font-size:12px}.sources summary{display:flex;align-items:center;justify-content:space-between;min-height:44px;color:var(--muted);font-weight:700;cursor:pointer}.sources ul{padding-left:18px;color:var(--muted);line-height:1.8;overflow-wrap:anywhere}.sources li{margin:8px 0}
  @media(max-width:760px){.food-page{width:calc(100% - clamp(32px,4vw,96px))}.food-hero{grid-template-columns:1fr;grid-template-areas:'image' 'credit' 'copy';align-items:start;column-gap:0;row-gap:0;padding:40px 0 35px}.hero-image{order:0;aspect-ratio:16/9;border-radius:25px}.hero-copy{align-self:start;margin-top:28px}.columns{grid-template-columns:1fr;gap:0}.info-card{position:static;grid-row:1;margin-bottom:24px}}
  @media(max-width:520px){h1{font-size:40px}.content-card{padding:21px;border-radius:24px}.review-top{align-items:flex-start;flex-direction:column;gap:5px}}
  @media(max-width:360px){.food-page{width:calc(100% - 32px)}.top{gap:8px}.back,.submit{font-size:10px}}
</style>
