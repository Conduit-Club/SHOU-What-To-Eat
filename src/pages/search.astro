---
import Layout from '../templates/Layout.astro';
---
<Layout title="选择目录"><main style="padding:40px"><h1>从目录开始找</h1><a href="/foods/">找餐品 →</a> · <a href="/restaurants/">找店铺 →</a></main></Layout>
<script>const params=new URLSearchParams(location.search);const type=params.get('type');params.delete('type');if(type==='stall')params.set('kind','stall');location.replace((type==='venue'||type==='stall'?'/restaurants/':'/foods/')+(params.size?'?'+params.toString():''));</script>
