---
import { getCollection } from 'astro:content';
import Layout from '../templates/Layout.astro';
import RestaurantFinder from '../components/RestaurantFinder';

const restaurants = (await getCollection('restaurants')).map(({ data }) => data).sort((a, b) => a.name.localeCompare(b.name, 'zh-CN'));
---

<Layout title="今日海大吃什么">
  <main class="page-shell">
    <header class="masthead">
      <a class="brand" href="/" aria-label="今日海大吃什么首页"><span class="brand-mark">食</span><span>今日海大吃什么</span></a>
      <a class="submit-link" href="/submit/">提交餐饮信息 <span aria-hidden="true">↗</span></a>
    </header>
    <section class="intro" aria-labelledby="page-title">
      <div><p class="eyebrow"><span class="live-dot"></span> 上海海洋大学 · 临港</p><h1 id="page-title">今天吃点什么？</h1><p class="intro-copy">从同学去过的店里，找一顿合口味的。</p></div>
      <div class="count"><strong>{restaurants.length}</strong><span>个去处</span></div>
    </section>
    <RestaurantFinder client:load restaurants={restaurants} />
    <footer><span>口味因人而异，价格与营业信息请以现场为准。</span><a href="/about/">关于本站</a></footer>
  </main>
</Layout>

<style>
  .page-shell{width:min(100%,1056px);margin:auto;padding:0 32px}
  .masthead{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line)}
  .brand{display:flex;align-items:center;min-width:0;min-height:44px;gap:10px;color:var(--ink);font-size:15px;font-weight:700;text-decoration:none}
  .brand-mark{display:grid;flex:0 0 30px;place-items:center;width:30px;height:30px;border-radius:8px;background:var(--orange);color:#fff;font-size:17px}
  .brand>span:last-child{overflow-wrap:anywhere}
  .submit-link{display:flex;align-items:center;flex:0 0 auto;min-height:44px;gap:8px;color:var(--ink);font-size:13px;font-weight:650;text-decoration:none}
  .submit-link span{color:var(--orange)}
  .intro{display:flex;justify-content:space-between;align-items:end;gap:24px;padding:48px 0 32px}
  .eyebrow{display:flex;align-items:center;gap:8px;margin:0 0 14px;color:var(--muted);font-size:12px}
  .live-dot{width:7px;height:7px;border-radius:50%;background:#51956e}
  .intro h1{margin:0;font-size:32px;line-height:1.3;font-weight:730;letter-spacing:0;overflow-wrap:anywhere}
  .intro-copy{margin:7px 0 0;color:var(--muted);font-size:14px;overflow-wrap:anywhere}
  .count{display:flex;align-items:baseline;flex:0 0 auto;gap:6px;color:var(--muted);font-size:12px}
  .count strong{color:var(--orange);font-size:24px}
  footer{display:flex;justify-content:space-between;gap:18px;padding:26px 0 40px;margin-top:28px;border-top:1px solid var(--line);color:var(--muted);font-size:12px;line-height:1.7}
  footer a{flex:0 0 auto;color:var(--muted);min-height:44px;display:flex;align-items:center}
  @media(max-width:600px){
    .page-shell{padding:0 18px}
    .masthead{min-height:60px;padding:8px 0}
    .brand{font-size:14px}
    .intro{align-items:flex-start;padding:35px 0 24px}
    .intro h1{font-size:28px}
    .intro-copy{font-size:13px}
    footer{align-items:flex-start;flex-wrap:wrap;gap:10px 16px;padding-bottom:30px}
  }
  @media(max-width:390px){
    .page-shell{padding:0 16px}
    .masthead{align-items:flex-start}
    .brand{flex:1}
    .submit-link{font-size:12px}
    .intro{display:block}
    .count{margin-top:18px}
  }
</style>
