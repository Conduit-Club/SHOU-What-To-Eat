---
import Layout from '../templates/Layout.astro';
---
<Layout title="查询投稿"><main class="status-page"><header><a href="/">← 返回目录</a><span>投稿回执</span></header><p class="eyebrow">SUBMISSION STATUS</p><h1>查询投稿进度</h1><p class="lead">使用提交时收到的回执编号和查询令牌。令牌只由你持有，本站不会公开展示稿件。</p><form id="status-form"><label>回执编号<input name="id" required autocomplete="off" /></label><label>查询令牌<input name="token" type="password" required autocomplete="off" /></label><button type="submit">查询状态 <span aria-hidden="true">→</span></button><p class="feedback" role="status" aria-live="polite"></p></form><section id="result" hidden><h2>当前状态</h2><p class="state"></p><p class="detail"></p></section></main></Layout>
<script>
  const form = document.querySelector<HTMLFormElement>('#status-form')!;
  const feedback = document.querySelector<HTMLElement>('.feedback')!;
  const result = document.querySelector<HTMLElement>('#result')!;
  const states: Record<string, string> = { pending: '等待审核', approved: '审核通过', rejected: '未通过审核', exporting: '正在准备内容 PR', export_failed: 'PR 准备失败，可联系维护者', merged_dev: '已进入预览分支，等待正式发布', merged_main: '已合入正式发布分支', deployed: '已发布' };
  const params = new URLSearchParams(location.search);
  const savedId = params.get('id');
  if (savedId) (form.elements.namedItem('id') as HTMLInputElement).value = savedId;
  form.addEventListener('submit', async (event) => {
    event.preventDefault(); feedback.textContent = '正在查询……'; result.hidden = true;
    const fields = new FormData(form); const id = String(fields.get('id')); const token = String(fields.get('token'));
    try {
      const response = await fetch(`/api/v1/submissions/${encodeURIComponent(id)}/status`, { headers: { Authorization: `Bearer ${token}` } });
      const body = await response.json(); if (!response.ok) throw new Error(body.error?.message || '查询失败。');
      document.querySelector<HTMLElement>('.state')!.textContent = states[body.status] ?? body.status;
      document.querySelector<HTMLElement>('.detail')!.textContent = `回执编号：${body.id} · 最后更新：${new Date(body.updatedAt).toLocaleString('zh-CN')}`;
      result.hidden = false; feedback.textContent = '';
    } catch (error) { feedback.textContent = error instanceof Error ? error.message : '暂时无法查询。'; }
  });
</script>
<style>.status-page{max-width:560px;margin:auto;padding:0 24px 60px}.status-page header{height:68px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);color:var(--muted);font-size:12px}.status-page header a{text-decoration:none}.eyebrow{margin:40px 0 12px;color:var(--orange);font-size:10px}.status-page h1{margin:0;font-size:28px;letter-spacing:0}.lead{margin:10px 0 26px;color:var(--muted);font-size:12px;line-height:1.8}form{display:grid;gap:14px}form label{display:grid;gap:7px;font-size:12px}form input{height:40px;padding:8px 10px;border:1px solid var(--line);border-radius:6px;background:transparent;color:var(--ink)}form button{height:42px;border:0;border-radius:6px;background:var(--orange);color:#fff;font-size:12px;cursor:pointer}.feedback,.detail{color:var(--muted);font-size:11px;line-height:1.8}#result{padding:14px;margin-top:14px;border:1px solid var(--line);border-radius:7px}#result h2{font-size:13px}#result p{font-size:13px}
</style>
