---
import Layout from '../templates/Layout.astro';
import { getCollection } from 'astro:content';
import PhotoUploader from '../components/PhotoUploader.astro';
import StarRating from '../components/StarRating.astro';
import snapshot from '../../public/catalog-snapshot.json';
const venues = (await getCollection('restaurants')).map(({ data }) => data).sort((a,b) => a.name.localeCompare(b.name,'zh-CN'));
---
<Layout title="提交餐饮信息">
  <main class="submit-page">
    <header class="page-top"><a href="/">← 返回食单</a><a href="/status/">投稿进度 ↗</a></header>
    <section class="submit-hero"><p class="eyebrow">SHOU FOOD · CONTRIBUTION</p><h1>分享一家店，<br />或你喜欢的那一口。</h1><p>补充店铺和餐品资料，也可以选填一条自己的用餐评价。审核后公开，未知信息请留空。<span class="required-mark">*</span> 为必填。</p></section>
    <form id="submission-form" class="submission-form" data-snapshot-id={snapshot.snapshotId} novalidate>
      <fieldset class="type-field"><legend>你想分享什么？</legend><div class="type-grid">
        <label><input type="radio" name="entityType" value="venue" checked /><span><b>餐厅 / 档口</b><small>补充一家值得去的店</small></span></label>
        <label><input type="radio" name="entityType" value="food" /><span><b>餐品</b><small>给店铺添一道餐品</small></span></label>
      </div></fieldset>
      <section id="venue-fields" class="form-section" aria-labelledby="venue-heading">
        <div class="section-heading"><div><p class="eyebrow">NEW PLACE</p><h2 id="venue-heading">餐厅或档口</h2></div><small>先把位置说清楚</small></div>
        <div class="row"><label><span>名称 <b class="required-mark" aria-hidden="true">*</b></span><input name="venueName" required maxlength="120" data-label="店铺名称" placeholder="例如：一食堂二楼酸菜鱼档口" /></label><label><span>类型 <b class="required-mark" aria-hidden="true">*</b></span><select name="venueType" required data-label="店铺类型"><option value="cafeteria">食堂</option><option value="stall">档口</option><option value="restaurant">餐厅</option><option value="cafe">咖啡 / 饮品店</option><option value="convenience">便利店</option></select></label></div>
        <div class="row"><label><span>范围 <b class="required-mark" aria-hidden="true">*</b></span><select name="venueCategory" required data-label="校内外范围"><option value="on-campus">校内</option><option value="off-campus">校外</option></select></label><label><span>标签</span><input name="venueTags" maxlength="1830" data-label="店铺标签" placeholder="面食，实惠，夜宵；最多 30 个" /></label></div>
        <label><span>位置或地址 <b class="required-mark" aria-hidden="true">*</b></span><input name="venueAddress" required maxlength="300" data-label="位置或地址" placeholder="楼栋、食堂楼层、街道或附近地标" /></label>
        <div class="row"><label><span>校区或区域</span><input name="venueCampusArea" maxlength="100" data-label="校区或区域" placeholder="例如：本科生宿舍区" /></label><label><span>楼层</span><input name="venueFloor" maxlength="100" data-label="楼层" placeholder="例如：二楼" /></label></div>
        <div class="row" id="distance-fields" hidden><label><span>距离（米）</span><input name="venueDistanceMeters" type="number" min="0" max="100000" step="1" inputmode="numeric" data-label="距离" placeholder="可留空，例如：500" /></label><label><span>距离依据 <b data-distance-required class="required-mark" aria-hidden="true" hidden>*</b></span><select name="venueDistanceBasis" data-label="距离依据"><option value="">未注明</option><option value="reported">投稿者报告</option><option value="walking">步行距离</option><option value="straight-line">直线距离</option></select></label></div>
        <label><span>介绍</span><textarea name="venueDescription" maxlength="2000" rows="4" data-label="店铺介绍" placeholder="只写你确认过的内容，不确定的部分可以留空。"></textarea></label>
        <div class="row"><label><span>平均消费（元 / 人）</span><input name="venuePrice" type="number" min="0" max="100000" step="0.01" inputmode="decimal" data-label="平均消费" placeholder="未知可留空" /></label><label><span>价格来源 <b data-price-required="venue" class="required-mark" aria-hidden="true" hidden>*</b></span><input name="venuePriceSource" maxlength="300" data-label="平均消费来源" placeholder="填写价格时，请注明菜单或现场标价" /></label></div>
      </section>
      <section id="food-fields" class="form-section" aria-labelledby="food-heading" hidden>
        <div class="section-heading"><div><p class="eyebrow">NEW DISH</p><h2 id="food-heading">餐品</h2></div><small>找到这道菜的归属</small></div>
        <label><span>所属餐厅 / 档口 <b class="required-mark" aria-hidden="true">*</b></span><select name="foodVenueId" required data-label="所属餐厅 / 档口"><option value="">请选择店铺</option>{venues.map(venue => <option value={venue.id}>{venue.name}</option>)}</select></label>
        <p class="field-note">店铺尚未收录？先投稿店铺，再使用回执里的“为此店铺添加餐品”。</p>
        <div class="row"><label><span>餐品名称 <b class="required-mark" aria-hidden="true">*</b></span><input name="foodName" required maxlength="120" data-label="餐品名称" placeholder="例如：酸菜鱼" /></label><label><span>餐段</span><select name="foodMealType" data-label="餐段"><option value="">未注明</option><option value="breakfast">早餐</option><option value="meal">正餐</option><option value="snack">小吃</option><option value="dessert">甜点</option><option value="drink">饮品</option></select></label></div>
        <label><span>餐品标签</span><input name="foodTags" maxlength="1830" data-label="餐品标签" placeholder="微辣，鱼类，下饭；最多 30 个" /></label>
        <label><span>餐品描述</span><textarea name="foodDescription" maxlength="1000" rows="4" data-label="餐品描述" placeholder="说说这道餐品是什么，最多 1000 字。"></textarea></label>
        <div class="row"><label><span>价格（元 / 份）</span><input name="foodPrice" type="number" min="0" max="100000" step="0.01" inputmode="decimal" data-label="餐品价格" placeholder="未知可留空" /></label><label><span>价格来源 <b data-price-required="food" class="required-mark" aria-hidden="true" hidden>*</b></span><input name="foodPriceSource" maxlength="300" data-label="餐品价格来源" placeholder="例如：店内菜单标价" /></label></div>
      </section>
      <aside class="media-column">
        <section class="form-section"><div class="section-heading"><div><p class="eyebrow">A PICTURE OF THIS PLACE</p><h2>给它添张照片</h2></div><small>选填</small></div>
          <PhotoUploader id="entity-images" title="添加店铺 / 餐品照片" />
          <div id="entity-previews" class="upload-previews" aria-live="polite"></div>
          <p class="field-note">图片会在你的浏览器内压缩为 WebP，并移除照片位置数据。</p>
        </section>
        <details class="attached-review form-section" id="attached-review"><summary><span class="review-summary-icon" aria-hidden="true">☆</span><span><strong>顺便留一条用餐评价</strong><small>选填 · 随资料一起审核</small></span><b aria-hidden="true">＋</b></summary>
          <div class="attached-body"><p class="field-note">可以只打星，也可以写最多 256 字并附图。不填写就只提交资料；填写后，评价会随资料一起审核、发布。</p><StarRating name="attachedRating" required={false} />
            <label><span>你的感受</span><textarea name="attachedText" rows="3" data-label="随稿评价" placeholder="味道、分量、服务，有什么想告诉同学的？" aria-describedby="attached-count"></textarea><small id="attached-count">0 / 256</small></label>
            <PhotoUploader id="review-images" title="添加用餐评价照片" limit={3} /><div id="review-previews" class="upload-previews" aria-live="polite"></div>
            <button type="button" id="remove-attached-review">不附评价，清空这一栏</button>
          </div>
        </details>
        <section class="form-section image-rights" id="image-metadata" hidden><div class="section-heading"><h2>照片来源与授权</h2></div>
          <label><span>照片来源 <b class="required-mark" aria-hidden="true">*</b></span><select name="photoOrigin" data-label="照片来源"><option value="own">我自己拍的</option><option value="licensed">已经获得授权的其他图片</option></select></label>
          <div id="external-rights" hidden><label><span>来源页或来源说明 <b class="required-mark" aria-hidden="true">*</b></span><input name="imageSource" maxlength="480" data-label="图片来源" placeholder="HTTPS 来源页或具体来源说明" /></label><div class="row"><label><span>作者 / 版权方 <b class="required-mark" aria-hidden="true">*</b></span><input name="imageHolder" maxlength="160" data-label="图片版权方" /></label><label><span>许可 <b class="required-mark" aria-hidden="true">*</b></span><input name="imageLicense" maxlength="120" data-label="图片许可" placeholder="许可名称或授权说明" /></label></div><label class="check-label"><input name="imageIllustrative" type="checkbox" /><span>这是示意图，并非本店实拍</span></label></div>
          <label class="check-label"><input name="rightsConfirmed" type="checkbox" data-label="照片使用权" /><span data-rights-label>这些照片由本人拍摄，我授权本站展示。</span><b class="required-mark" aria-hidden="true">*</b></label>
          <p class="field-note">此声明适用于本次选择的全部照片；混合来源的照片请分别投稿。</p>
        </section>
      </aside>
      <div class="submission-bottom"><p class="notice">ⓘ 资料与随稿评价通过审核后公开。不要填写私人联系方式；提交成功表示已收到，不代表已发布。</p><div id="turnstile-slot"></div><button class="submit-button" type="submit">提交审核 <span aria-hidden="true">→</span></button><button id="retry-submission" type="button" hidden>继续保存上一份投稿</button><p class="feedback" role="status" aria-live="polite"></p><button id="draft" class="draft" type="button">下载本地草稿</button></div>
    </form>
    <section id="receipt-panel" class="form-section receipt-panel" hidden aria-labelledby="receipt-heading"><h2 id="receipt-heading">投稿已收到，保存好这份回执</h2><p class="field-note">令牌用于私下查询进度，请妥善保存。</p><div class="row"><label>回执编号<input id="receipt-id" readonly autocomplete="off" /></label><label id="receipt-entity-row">内容编号<input id="receipt-entity-id" readonly autocomplete="off" /></label></div><label>查询令牌<div class="token-control"><input id="receipt-token" type="password" readonly autocomplete="off" /><button id="receipt-token-toggle" type="button" aria-pressed="false">显示</button></div></label><div class="receipt-actions"><a id="receipt-status-link" href="/status/">查询此投稿 →</a><a id="receipt-food-link" href="/submit/" hidden>为此店铺添加餐品 ＋</a></div></section>
  </main>
</Layout>
<script>
  import { initSubmissionForm } from '../utils/submission-form';
  initSubmissionForm();
</script>
<style>
  .submit-page{width:calc(100% - clamp(32px,4vw,96px));margin:auto;padding-bottom:55px}.page-top{display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:70px;border-bottom:1px solid var(--line);font-size:12px;color:var(--muted)}.page-top a{display:flex;align-items:center;min-height:44px;text-decoration:none}.submit-hero{padding:40px 0 32px;max-width:760px}.eyebrow{margin:0 0 12px;color:var(--orange-deep);font-size:10px;font-weight:800;letter-spacing:.13em}.submit-hero h1{margin:0;font-size:clamp(32px,3.7vw,50px);letter-spacing:-.045em;line-height:1.22}.submit-hero>p:last-child{font-size:13px;line-height:1.85;color:var(--muted);max-width:620px;margin:18px 0 0}.submission-form{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:22px;align-items:start}.type-field,.submission-bottom{grid-column:1/-1}.type-field{min-width:0;margin:0;padding:22px 24px;border:1px solid var(--line);border-radius:24px;background:white}.type-field legend{padding:0 5px;font-size:13px;font-weight:800}.type-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.type-grid label{position:relative;cursor:pointer}.type-grid input{position:absolute;inset:0;width:100%;height:100%;opacity:0;margin:0;cursor:pointer}.type-grid span{display:grid;gap:6px;padding:17px 20px;border:1px solid var(--line);border-radius:16px;background:#fffdf9}.type-grid b{font-size:14px}.type-grid small{font-size:11px;color:var(--muted)}.type-grid input:checked+span{border-color:var(--orange);background:#fff0e6}.type-grid input:focus-visible+span{outline:3px solid var(--focus);outline-offset:3px}.form-section{min-width:0;padding:26px;border:1px solid #f0e3da;border-radius:26px;background:white;box-shadow:var(--shadow-card)}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:24px}.section-heading .eyebrow{margin-bottom:8px}.section-heading h2,.receipt-panel h2{margin:0;font-size:24px;letter-spacing:-.03em}.section-heading small{font-size:10px;color:var(--muted)}.form-section>label,.row label,.attached-body>label,#external-rights>label{display:grid;gap:9px;font-size:12px;font-weight:750;margin-top:17px}.row{display:grid;grid-template-columns:1fr 1fr;gap:16px}.row label{min-width:0;align-content:start}.row:first-of-type label{margin-top:0}.form-section input:not([type=radio]):not([type=checkbox]):not([type=file]),.form-section select,.form-section textarea{width:100%;min-width:0;min-height:50px;padding:12px 14px;border:1px solid var(--line);border-radius:14px;background:var(--surface-soft);color:var(--ink);font-size:16px}.form-section textarea{resize:vertical;line-height:1.75}.form-section input:focus,.form-section textarea:focus,.form-section select:focus{border-color:var(--orange)}.field-note,.attached-body>label>small{color:var(--muted);font-size:11px;font-weight:400;line-height:1.8}.media-column{display:grid;min-width:0;gap:18px}.attached-review{padding:0;overflow:hidden}.attached-review summary{list-style:none;display:flex;align-items:center;gap:12px;padding:22px 24px;cursor:pointer;min-height:90px}.attached-review summary::-webkit-details-marker{display:none}.review-summary-icon{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:#fff0d5;color:#9c6912;font-size:26px;flex:none}.attached-review summary>span:nth-child(2){display:grid;gap:6px}.attached-review summary strong{font-size:14px}.attached-review summary small{font-size:10px;color:var(--muted)}.attached-review summary>b{margin-left:auto;color:var(--orange);font-size:24px}.attached-review[open] summary>b{transform:rotate(45deg)}.attached-review[open] summary{border-bottom:1px solid var(--line)}.attached-body{padding:20px 24px}.attached-body>.field-note{margin:0 0 20px}.attached-body .photo-picker{margin-top:20px}.attached-body>button{min-height:44px;margin-top:10px;border:0;background:transparent;color:var(--muted);font-size:11px;text-decoration:underline}.check-label{display:flex!important;align-items:center;gap:10px;min-height:44px;line-height:1.8}.check-label input{width:20px;height:20px;flex:none;accent-color:var(--orange)}.image-rights{background:#f7fbf4}.submission-bottom{display:grid;gap:16px}.notice{margin:0;padding:17px 20px;border-radius:17px;background:#fff7e3;color:var(--muted);font-size:12px;line-height:1.8}.submit-button{min-height:55px;border:0;border-radius:17px;background:var(--orange);color:#fff;font-size:15px;font-weight:800}.submit-button span{margin-left:10px}.submit-button:disabled{opacity:.55;cursor:not-allowed}#retry-submission{min-height:50px;border:1px solid #c6906f;border-radius:15px;background:#fff1e6;color:var(--orange-deep)}.feedback{margin:0;min-height:18px;font-size:12px;line-height:1.8;color:var(--muted)}.feedback[data-tone=error]{color:#a3312b}.feedback[data-tone=success]{color:var(--green)}.draft{min-height:44px;border:0;background:transparent;color:var(--muted);font-size:11px;text-decoration:underline}.receipt-panel{margin-top:25px;display:grid;gap:14px}.receipt-panel label{margin:0}.token-control{display:flex;gap:10px}.token-control input{min-width:0}.token-control button{min-width:65px;border:1px solid var(--line);border-radius:12px;background:#fff0e5;color:var(--orange-deep)}.receipt-actions{display:flex;flex-wrap:wrap;gap:15px}.receipt-actions a{display:inline-flex;align-items:center;min-height:44px;color:var(--orange-deep);font-size:13px;font-weight:750}[hidden]{display:none!important}
  @media(max-width:1000px){.submission-form{grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:16px}.form-section{padding:22px}.row{gap:12px}.attached-body{padding:20px}.attached-review{padding:0}.attached-review summary{padding:20px}.section-heading small{display:none}}
  @media(max-width:760px){.submit-hero{padding:30px 0}.submission-form{grid-template-columns:1fr}.type-field,.submission-bottom{grid-column:1}.type-field{padding:16px}.type-grid{gap:10px}.type-grid span{padding:14px 12px}.form-section{padding:20px;border-radius:22px}.attached-review{padding:0}.row{grid-template-columns:1fr}.row label{margin-top:17px!important}.row label:first-child{margin-top:0!important}.section-heading{margin-bottom:20px}.submit-hero h1{font-size:36px}.receipt-actions{display:grid}.receipt-panel h2{font-size:23px}}
</style>
