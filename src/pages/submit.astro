      let version = receipt.version;
      if (entityImagesCount) version = await submitImages(submissionId, receiptToken, version, entityImages.slice(0, entityImagesCount), 'entity', 0, updatePendingVersion);
      if (reviewImagesCount) version = await submitImages(submissionId, receiptToken, version, reviewImages.slice(0, reviewImagesCount), 'attachedReview', 0, updatePendingVersion);
      await finalizeReceipt(receipt, version);
      if ((type === 'venue' || type === 'food') && receipt.entityId) writeSession('shou-parent-receipt:' + receipt.entityId, receiptToken);
      clearPendingReceipt();
      showReceipt(receipt);
      showMessage('投稿已收到，请在下方保存回执信息。', 'success');
      resetSubmissionForm();
    } catch (error) {
      const detail = error instanceof Error ? error.message : '暂时无法提交，请稍后再试。';
      showMessage(pendingReceipt ? detail + ' 已保留回执，可点击“继续保存上一份投稿”重试。' : detail, 'error');
    } finally {
      submitButton.disabled = false;
    }
  });
  retryButton.addEventListener('click', async () => {
    const receipt = pendingReceipt;
    if (!receipt) return;
    retryButton.disabled = true;
    submitButton.disabled = true;
    try {
      const current = await receiptStatus(receipt);
      const retryReceipt: PendingReceipt = { ...receipt, ...(current.entityId || receipt.entityId ? { entityId: current.entityId || receipt.entityId } : {}) };
      savePendingReceipt(retryReceipt);
      let version = current.version;
      updatePendingVersion(version);
      const missingEntity = retryReceipt.expectedImages - current.uploadedImages;
      const missingReview = retryReceipt.expectedReviewImages - current.uploadedReviewImages;
      if (missingEntity > 0 && entityImages.length < retryReceipt.expectedImages) throw new Error('上一份投稿仍缺少实体图片，请重新选择未保存的图片后重试。');
      if (missingReview > 0 && reviewImages.length < retryReceipt.expectedReviewImages) throw new Error('上一份投稿仍缺少附加评价图片，请重新选择未保存的图片后重试。');
      if (missingEntity > 0) version = await submitImages(retryReceipt.submissionId, retryReceipt.receiptToken, version, entityImages.slice(0, retryReceipt.expectedImages), 'entity', current.uploadedImages, updatePendingVersion);
      if (missingReview > 0) version = await submitImages(retryReceipt.submissionId, retryReceipt.receiptToken, version, reviewImages.slice(0, retryReceipt.expectedReviewImages), 'attachedReview', current.uploadedReviewImages, updatePendingVersion);
      const finalized = await finalizeReceipt(retryReceipt, version);
      const finalizedEntityId = finalized && typeof finalized === 'object' && typeof finalized.entityId === 'string' ? finalized.entityId.trim() : '';
      const completedReceipt: PendingReceipt = { ...retryReceipt, ...(finalizedEntityId ? { entityId: finalizedEntityId } : {}) };
      if ((completedReceipt.type === 'venue' || completedReceipt.type === 'food') && completedReceipt.entityId) writeSession('shou-parent-receipt:' + completedReceipt.entityId, completedReceipt.receiptToken);
      clearPendingReceipt();
      showReceipt(completedReceipt);
      showMessage('投稿已收到，请在下方保存回执信息。', 'success');
      resetSubmissionForm();
    } catch (error) {
      showMessage(error instanceof Error ? error.message + ' 回执仍已保留。' : '重试失败，回执仍已保留。', 'error');
    } finally {
      retryButton.disabled = false;
      submitButton.disabled = false;
    }
  });
  document.querySelector<HTMLButtonElement>('#draft')!.addEventListener('click', () => {
    const data = draftData(currentType());
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'shou-food-submission-v2.json';
    link.click();
    URL.revokeObjectURL(link.href);
  });
</script>
