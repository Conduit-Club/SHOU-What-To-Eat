---
import Layout from '../templates/Layout.astro';
import snapshot from '../../public/catalog-snapshot.json';

const catalogSnapshotId = snapshot.snapshotId;
---
<Layout title="提交餐饮信息">
  <main class="submit-page">
    <header class="top"><a href="/" class="back"><span aria-hidden="true">←</span> 返回目录</a><span class="page-label">投稿</span></header>
    <section class="submit-hero">
      <p class="eyebrow">SHOU FOOD · CONTRIBUTION</p>
      <h1>把你知道的一口，留给下一位同学。</h1>
      <p class="lead">可以提交餐厅或档口、餐品，也可以为已发布内容写一条独立评价。没有照片也可以投稿，未知信息请留空。</p>
    </section>

    <form id="submission-form" class="submission-form" data-snapshot-id={catalogSnapshotId}>
      <fieldset class="type-field">
        <legend>你想分享什么？</legend>
        <div class="type-grid" role="radiogroup" aria-label="投稿类型">
          <label><input type="radio" name="entityType" value="venue" checked /><span><b>餐厅 / 档口</b><small>新增一个餐饮点</small></span></label>
          <label><input type="radio" name="entityType" value="food" /><span><b>餐品</b><small>绑定到一个店铺</small></span></label>
          <label><input type="radio" name="entityType" value="review" /><span><b>独立评价</b><small>评价已发布内容</small></span></label>
        </div>
      </fieldset>

      <section id="venue-fields" class="form-section" aria-labelledby="venue-heading">
        <div class="section-heading"><div><p class="section-kicker">NEW PLACE</p><h2 id="venue-heading">餐厅或档口</h2></div><span class="section-hint">可不附评价</span></div>
        <div class="row"><label>名称 <input id="venue-name" name="venueName" maxlength="160" placeholder="例如：一食堂二楼" /></label><label>类型<select id="venue-type" name="venueType"><option value="cafeteria">食堂</option><option value="stall">档口</option><option value="restaurant">餐厅</option><option value="cafe">咖啡 / 饮品店</option><option value="convenience">便利店</option></select></label></div>
        <div class="row"><label>范围<select id="venue-category" name="venueCategory"><option value="on-campus">校内</option><option value="off-campus">校外</option></select></label><label>标签 <input name="venueTags" maxlength="800" placeholder="用逗号分隔，可留空" /></label></div>
        <label>位置或地址 <input id="venue-address" name="venueAddress" maxlength="500" placeholder="楼栋、食堂楼层、商圈或附近地标" /></label>
        <div class="row"><label>校区或区域 <input name="venueCampusArea" maxlength="160" placeholder="例如：本科生宿舍区；可留空" /></label><label>楼层 <input name="venueFloor" maxlength="120" placeholder="例如：一楼；可留空" /></label></div>
        <div class="row"><label>距离（米） <input name="venueDistanceMeters" type="number" min="0" max="100000" step="1" inputmode="numeric" placeholder="校外可填写；可留空" /></label><label>距离依据<select name="venueDistanceBasis"><option value="">未注明</option><option value="reported">投稿者报告</option><option value="walking">步行距离</option><option value="straight-line">直线距离</option></select></label></div>
        <label>介绍 <textarea name="venueDescription" maxlength="2000" rows="5" placeholder="只写你确认过的内容；不确定的部分可以留空。"></textarea></label>
        <div class="row"><label>平均消费（元 / 人）<input name="venuePrice" type="number" min="0" max="100000" step="0.01" inputmode="decimal" placeholder="可留空" /></label><label>价格来源 <input name="venuePriceSource" maxlength="300" placeholder="菜单、现场标价等；可留空" /></label></div>
      </section>

      <section id="food-fields" class="form-section" aria-labelledby="food-heading" hidden>
        <div class="section-heading"><div><p class="section-kicker">NEW DISH</p><h2 id="food-heading">餐品</h2></div><span class="section-hint">需要绑定店铺</span></div>
        <label>所属店铺 ID <input id="food-venue-id" name="foodVenueId" maxlength="160" placeholder="公开店铺 ID，或你刚提交的待审店铺 ID" /></label>
        <p class="field-note">已发布店铺可直接绑定；刚提交的店铺请使用回执页面提供的 entity ID。父回执只会私下发送给 API，不会写进公开内容。</p>
        <div class="row"><label>餐品名称 <input id="food-name" name="foodName" maxlength="160" placeholder="例如：滑蛋饭" /></label><label>餐段<select name="foodMealType"><option value="">未注明</option><option value="breakfast">早餐</option><option value="meal">正餐</option><option value="snack">小吃</option><option value="dessert">甜点</option><option value="drink">饮品</option></select></label></div>
        <label>餐品标签 <input name="foodTags" maxlength="800" placeholder="用逗号分隔，可留空" /></label>
        <label>餐品描述 <textarea name="foodDescription" maxlength="2000" rows="5" placeholder="只写已知的餐品信息。"></textarea></label>
        <div class="row"><label>价格（元）<input name="foodPrice" type="number" min="0" max="100000" step="0.01" inputmode="decimal" placeholder="可留空" /></label><label>价格来源 <input name="foodPriceSource" maxlength="300" placeholder="菜单、现场标价等；可留空" /></label></div>
      </section>

      <section id="review-fields" class="form-section" aria-labelledby="review-heading" hidden>
        <div class="section-heading"><div><p class="section-kicker">STUDENT NOTE</p><h2 id="review-heading">独立评价</h2></div><span class="section-hint">评分必填</span></div>
        <div class="row"><label>评价对象<select name="reviewTargetType"><option value="venue">餐厅 / 档口</option><option value="food">餐品</option></select></label><label>对象 ID <input id="review-target-id" name="reviewTargetId" maxlength="160" placeholder="已发布内容的 ID" /></label></div>
        <fieldset class="rating-field"><legend>评分 <span>请选择 1–5 星</span></legend><div class="rating-options">{[1, 2, 3, 4, 5].map((rating) => <label><input type="radio" name="reviewRating" value={rating} /><span aria-label={rating + ' 星'}>{'★'.repeat(rating)}</span></label>)}</div></fieldset>
        <label>评价文字 <textarea name="reviewText" maxlength="256" rows="5" placeholder="最多 256 个 Unicode 字符，写下你的实际体验。"></textarea><small class="char-count" data-count-for="reviewText">0 / 256</small></label>
      </section>

      <section id="attached-review" class="form-section attached-section" aria-labelledby="attached-heading" hidden>
        <div class="section-heading"><div><p class="section-kicker">OPTIONAL NOTE</p><h2 id="attached-heading">附一条评价</h2></div><span class="section-hint">可关闭</span></div>
        <label class="check-label"><input id="attached-enabled" type="checkbox" name="attachedEnabled" /><span>同时分享这家店 / 这道餐品的实际体验</span></label>
        <div id="attached-fields" hidden>
          <fieldset class="rating-field"><legend>评分 <span>请选择 1–5 星</span></legend><div class="rating-options">{[1, 2, 3, 4, 5].map((rating) => <label><input type="radio" name="attachedRating" value={rating} /><span aria-label={rating + ' 星'}>{'★'.repeat(rating)}</span></label>)}</div></fieldset>
          <label>评价文字 <textarea name="attachedText" maxlength="256" rows="4" placeholder="可只打星，也可以补充不超过 256 个 Unicode 字符的文字。"></textarea><small class="char-count" data-count-for="attachedText">0 / 256</small></label>
        </div>
      </section>

      <section class="form-section media-section" aria-labelledby="media-heading">
        <div class="section-heading"><div><p class="section-kicker">OPTIONAL PHOTOS</p><h2 id="media-heading">照片</h2></div><span class="section-hint">图片会压缩为 WebP并移除 EXIF</span></div>
        <label class="file-label"><span>实体照片 <small id="entity-file-hint">最多 6 张；可留空</small></span><input id="entity-images" type="file" accept="image/*" multiple /></label>
        <div id="entity-previews" class="previews" aria-live="polite"></div>
        <label id="review-file-label" class="file-label" hidden><span>附加评价照片 <small>最多 3 张；可留空</small></span><input id="review-images" type="file" accept="image/*" multiple /></label>
        <div id="review-previews" class="previews" aria-live="polite"></div>
        <div id="image-metadata" class="metadata" hidden>
          <p class="field-note">上传图片前请填写来源、版权方和许可。每张图片都需要替代文本；浏览器会将图片缩放并转码为 WebP（不超过 2 MiB），同时去除原始 EXIF。公开内容会保留来源页和许可信息。</p>
          <div class="row"><label>图片来源 <input id="image-source" name="imageSource" maxlength="500" placeholder="例如：本人拍摄 / 菜单公开页" /></label><label>版权方 <input id="image-holder" name="imageHolder" maxlength="200" placeholder="本人或明确的权利人" /></label></div>
          <div class="row"><label>许可 <input id="image-license" name="imageLicense" maxlength="120" placeholder="例如：CC BY-SA 4.0 或本人授权展示" /></label><div class="metadata-checks"><label class="check-label"><input id="image-illustrative" name="imageIllustrative" type="checkbox" /><span>这是示意图</span></label><label class="check-label rights"><input id="rights-confirmed" name="rightsConfirmed" type="checkbox" /><span>我确认有权提交这些图片</span></label></div></div>
        </div>
      </section>

      <div class="notice"><span aria-hidden="true">ⓘ</span><p>投稿由管理员审核，通过后才会进入公开目录。不要填写个人联系方式、他人账号或仅供审核使用的内容；未知信息请保留为空。</p></div>
      <div id="turnstile-slot"></div>
      <button class="submit-button" type="submit">提交审核 <span aria-hidden="true">→</span></button>
      <button id="retry-submission" class="retry-button" type="button" hidden>继续保存上一份投稿</button>
      <p class="feedback" role="status" aria-live="polite"></p>
      <button id="draft" class="draft" type="button">下载本地草稿</button>
    </form>
    <section id="receipt-panel" class="receipt-panel" hidden aria-labelledby="receipt-heading">
      <div class="section-heading"><div><p class="section-kicker">YOUR RECEIPT</p><h2 id="receipt-heading">保存这份投稿回执</h2></div><span class="section-hint">仅当前标签页</span></div>
      <p class="receipt-note">回执编号和实体 ID 可用于后续查询与绑定餐品。查询令牌默认遮蔽，请在离开前手动保存。</p>
      <div class="receipt-fields">
        <label>回执编号<input id="receipt-id" type="text" readonly autocomplete="off" spellcheck="false" /></label>
        <label id="receipt-entity-row">实体 ID<input id="receipt-entity-id" type="text" readonly autocomplete="off" spellcheck="false" /></label>
        <label>查询令牌<div class="token-control"><input id="receipt-token" type="password" readonly autocomplete="off" spellcheck="false" /><button id="receipt-token-toggle" type="button" aria-pressed="false">显示</button></div></label>
      </div>
      <div class="receipt-actions"><a id="receipt-status-link" href="/status/">查询此投稿</a><a id="receipt-food-link" href="/submit/" hidden>为此店铺添加餐品</a></div>
    </section>
  </main>
</Layout>
<script>
  import { turnstileWidget } from '../utils/turnstile-client';

  type EntityType = 'venue' | 'food' | 'review';
  type ImageSelection = { file: File; preview: string; alt: string };
  type PendingReceipt = { submissionId: string; receiptToken: string; version: number; type: EntityType; expectedImages: number; expectedReviewImages: number; entityId?: string };
  const form = document.querySelector<HTMLFormElement>('#submission-form')!;
  const feedback = document.querySelector<HTMLElement>('.feedback')!;
  const submitButton = document.querySelector<HTMLButtonElement>('.submit-button')!;
  const retryButton = document.querySelector<HTMLButtonElement>('#retry-submission')!;
  const receiptPanel = document.querySelector<HTMLElement>('#receipt-panel')!;
  const receiptIdInput = document.querySelector<HTMLInputElement>('#receipt-id')!;
  const receiptEntityRow = document.querySelector<HTMLElement>('#receipt-entity-row')!;
  const receiptEntityInput = document.querySelector<HTMLInputElement>('#receipt-entity-id')!;
  const receiptTokenInput = document.querySelector<HTMLInputElement>('#receipt-token')!;
  const receiptTokenToggle = document.querySelector<HTMLButtonElement>('#receipt-token-toggle')!;
  const receiptStatusLink = document.querySelector<HTMLAnchorElement>('#receipt-status-link')!;
  const receiptFoodLink = document.querySelector<HTMLAnchorElement>('#receipt-food-link')!;
  const entityFields = document.querySelector<HTMLElement>('#venue-fields')!;
  const foodFields = document.querySelector<HTMLElement>('#food-fields')!;
  const reviewFields = document.querySelector<HTMLElement>('#review-fields')!;
  const attachedSection = document.querySelector<HTMLElement>('#attached-review')!;
  const attachedFields = document.querySelector<HTMLElement>('#attached-fields')!;
  const reviewFileLabel = document.querySelector<HTMLElement>('#review-file-label')!;
  const entityInput = document.querySelector<HTMLInputElement>('#entity-images')!;
  const reviewInput = document.querySelector<HTMLInputElement>('#review-images')!;
  const entityPreviews = document.querySelector<HTMLElement>('#entity-previews')!;
  const reviewPreviews = document.querySelector<HTMLElement>('#review-previews')!;
  const metadata = document.querySelector<HTMLElement>('#image-metadata')!;
  const snapshotId = form.dataset.snapshotId ?? '';
  const pendingReceiptKey = 'shou-pending-submission-v2';
  const receiptHistoryKey = 'shou-submission-receipts-v2';
  let entityImages: ImageSelection[] = [];
  let reviewImages: ImageSelection[] = [];
  let pendingReceipt: PendingReceipt | null = null;

  function currentType(): EntityType {
    return (form.querySelector<HTMLInputElement>('input[name="entityType"]:checked')?.value as EntityType | undefined) ?? 'venue';
  }
  function setDisabled(root: HTMLElement, disabled: boolean) {
    root.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea').forEach((control) => { control.disabled = disabled; });
  }
  function switchType() {
    const type = currentType();
    entityFields.hidden = type !== 'venue';
    foodFields.hidden = type !== 'food';
    reviewFields.hidden = type !== 'review';
    attachedSection.hidden = type === 'review';
    reviewFileLabel.hidden = type === 'review' || !document.querySelector<HTMLInputElement>('#attached-enabled')!.checked;
    setDisabled(entityFields, type !== 'venue');
    setDisabled(foodFields, type !== 'food');
    setDisabled(reviewFields, type !== 'review');
    setDisabled(attachedFields, type === 'review' || !document.querySelector<HTMLInputElement>('#attached-enabled')!.checked);
    setDisabled(reviewFileLabel, reviewFileLabel.hidden);
    if (type === 'review') entityInput.setAttribute('data-max', '3');
    else entityInput.setAttribute('data-max', '6');
    updateMetadataVisibility();
  }
  function updateAttached() {
    const enabled = document.querySelector<HTMLInputElement>('#attached-enabled')!.checked && currentType() !== 'review';
    attachedFields.hidden = !enabled;
    reviewFileLabel.hidden = !enabled;
    setDisabled(attachedFields, !enabled);
    setDisabled(reviewFileLabel, !enabled);
    updateMetadataVisibility();
  }
  function updateMetadataVisibility() {
    metadata.hidden = entityImages.length === 0 && reviewImages.length === 0;
  }
  function updateCount(name: string) {
    const control = form.elements.namedItem(name) as HTMLTextAreaElement | null;
    const count = document.querySelector<HTMLElement>('[data-count-for="' + name + '"]');
    if (control && count) count.textContent = Array.from(control.value).length + ' / 256';
  }
  function showMessage(message: string, tone: 'error' | 'success' | 'info' = 'info') {
    feedback.textContent = message;
    feedback.dataset.tone = tone;
  }
  function savePendingReceipt(receipt: PendingReceipt) {
    pendingReceipt = receipt;
    retryButton.hidden = false;
    try { sessionStorage.setItem(pendingReceiptKey, JSON.stringify(receipt)); } catch { /* Private browsing may disable sessionStorage. */ }
  }
  function readSession(key: string) {
    try { return sessionStorage.getItem(key); } catch { return null; }
  }
  function writeSession(key: string, value: string) {
    try { sessionStorage.setItem(key, value); } catch { /* Private browsing may disable sessionStorage. */ }
  }
  function saveReceipt(receipt: PendingReceipt) {
    const raw = readSession(receiptHistoryKey);
    let receipts: Record<string, PendingReceipt> = {};
    try {
      const parsed = raw ? JSON.parse(raw) : null;
      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) receipts = parsed as Record<string, PendingReceipt>;
    } catch { /* Ignore malformed or unavailable private storage. */ }
    receipts[receipt.submissionId] = { submissionId: receipt.submissionId, receiptToken: receipt.receiptToken, type: receipt.type, version: receipt.version, expectedImages: receipt.expectedImages, expectedReviewImages: receipt.expectedReviewImages, ...(receipt.entityId ? { entityId: receipt.entityId } : {}) };
    writeSession(receiptHistoryKey, JSON.stringify(receipts));
  }
  function showReceipt(receipt: PendingReceipt) {
    const entityId = receipt.entityId?.trim() ?? '';
    saveReceipt(receipt);
    receiptIdInput.value = receipt.submissionId;
    receiptEntityInput.value = entityId;
    receiptEntityRow.hidden = !entityId;
    receiptTokenInput.value = receipt.receiptToken;
    receiptTokenInput.type = 'password';
    receiptTokenToggle.textContent = '显示';
    receiptTokenToggle.setAttribute('aria-pressed', 'false');
    receiptStatusLink.href = '/status/?id=' + encodeURIComponent(receipt.submissionId);
    receiptFoodLink.hidden = receipt.type !== 'venue' || !entityId;
    receiptFoodLink.href = entityId ? '/submit/?venueEntityId=' + encodeURIComponent(entityId) : '/submit/';
    receiptPanel.hidden = false;
  }
  function updatePendingVersion(version: number) {
    if (!pendingReceipt) return;
    savePendingReceipt({ ...pendingReceipt, version });
  }
  function clearPendingReceipt() {
    pendingReceipt = null;
    retryButton.hidden = true;
    try { sessionStorage.removeItem(pendingReceiptKey); } catch { /* Ignore storage cleanup failures. */ }
  }
  function restorePendingReceipt() {
    try {
      const parsed = JSON.parse(readSession(pendingReceiptKey) ?? 'null') as Partial<PendingReceipt> | null;
      if (!parsed || typeof parsed.submissionId !== 'string' || typeof parsed.receiptToken !== 'string' || !parsed.submissionId || !parsed.receiptToken || !['venue', 'food', 'review'].includes(String(parsed.type)) || !Number.isSafeInteger(parsed.version) || !Number.isSafeInteger(parsed.expectedImages) || !Number.isSafeInteger(parsed.expectedReviewImages)) return;
      pendingReceipt = parsed as PendingReceipt;
      retryButton.hidden = false;
      const typeInput = form.querySelector<HTMLInputElement>(`input[name="entityType"][value="${pendingReceipt.type}"]`);
      if (typeInput) { typeInput.checked = true; switchType(); }
    } catch { /* Ignore malformed or unavailable private storage. */ }
  }
  function renderPreviews(kind: 'entity' | 'review') {
    const list = kind === 'entity' ? entityPreviews : reviewPreviews;
    const images = kind === 'entity' ? entityImages : reviewImages;
    list.replaceChildren();
    images.forEach((image, index) => {
      const item = document.createElement('div');
      item.className = 'preview-item';
      const preview = document.createElement('img');
      preview.src = image.preview;
      preview.alt = image.alt;
      const label = document.createElement('label');
      label.textContent = '替代文本';
      const input = document.createElement('input');
      input.type = 'text';
      input.maxLength = 200;
      input.required = true;
      input.value = image.alt;
      input.placeholder = '描述图片内容';
      input.addEventListener('input', () => { image.alt = input.value; preview.alt = input.value || '投稿图片'; });
      label.append(input);
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'remove-image';
      remove.textContent = '移除';
      remove.addEventListener('click', () => {
        URL.revokeObjectURL(image.preview);
        images.splice(index, 1);
        renderPreviews(kind);
        updateMetadataVisibility();
      });
      item.append(preview, label, remove);
      list.append(item);
    });
  }
  async function readImage(file: File): Promise<ImageSelection | null> {
    if (!file.type.startsWith('image/')) return null;
    const preview = URL.createObjectURL(file);
    return { file, preview, alt: '' };
  }
  async function addFiles(kind: 'entity' | 'review', fileList: FileList | null) {
    if (!fileList) return;
    const maxCount = kind === 'entity' ? (currentType() === 'review' ? 3 : 6) : 3;
    const target = kind === 'entity' ? entityImages : reviewImages;
    const incoming = Array.from(fileList).slice(0, Math.max(0, maxCount - target.length));
    if (fileList.length > incoming.length) showMessage('图片数量已按当前投稿类型限制。', 'info');
    for (const file of incoming) {
      const image = await readImage(file);
      if (image) target.push(image);
    }
    renderPreviews(kind);
    updateMetadataVisibility();
  }
  function inputFiles(input: HTMLInputElement, kind: 'entity' | 'review') {
    input.addEventListener('change', async () => { await addFiles(kind, input.files); input.value = ''; });
  }
  async function compressImage(selection: ImageSelection): Promise<Blob> {
    const source = await createImageBitmap(selection.file);
    const canvas = document.createElement('canvas');
    const maxSide = 2000;
    const scale = Math.min(1, maxSide / Math.max(source.width, source.height));
    canvas.width = Math.max(1, Math.round(source.width * scale));
    canvas.height = Math.max(1, Math.round(source.height * scale));
    const context = canvas.getContext('2d');
    if (!context) throw new Error('无法读取图片。');
    context.drawImage(source, 0, 0, canvas.width, canvas.height);
    source.close();
    let quality = 0.84;
    for (let attempt = 0; attempt < 5; attempt += 1) {
      const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/webp', quality));
      if (!blob) throw new Error('无法压缩图片。');
      if (blob.size <= 2 * 1024 * 1024) return blob;
      quality -= 0.12;
    }
    throw new Error('图片压缩后仍超过 2 MiB，请选择更小的图片。');
  }
  function encodeMetadataValue(value: string) {
    return encodeURIComponent(value.trim());
  }
  function metadataHeaders(image: ImageSelection) {
    return {
      'Content-Type': 'image/webp',
      'X-Image-Metadata-Encoding': 'percent-utf8',
      'X-Image-Alt': encodeMetadataValue(image.alt),
      'X-Image-Source': encodeMetadataValue(document.querySelector<HTMLInputElement>('#image-source')!.value),
      'X-Image-Copyright-Holder': encodeMetadataValue(document.querySelector<HTMLInputElement>('#image-holder')!.value),
      'X-Image-License': encodeMetadataValue(document.querySelector<HTMLInputElement>('#image-license')!.value),
      'X-Image-Rights-Confirmed': String(document.querySelector<HTMLInputElement>('#rights-confirmed')!.checked),
      'X-Image-Is-Illustrative': String(document.querySelector<HTMLInputElement>('#image-illustrative')!.checked),
    };
  }
  function fields(name: string) {
    return form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
  }
  function value(name: string) { return fields(name)?.value.trim() ?? ''; }
  function numberOrNull(name: string) {
    const raw = value(name);
    if (!raw) return null;
    const parsed = Number(raw);
    return Number.isFinite(parsed) && parsed >= 0 ? parsed : null;
  }
  function tags(name: string) { return value(name).split(',').map((tag) => tag.trim()).filter(Boolean); }
  function price(name: string, sourceName: string, unit: '人' | '份') {
    const amount = numberOrNull(name);
    if (amount === null) return null;
    return { amountCents: Math.round(amount * 100), currency: 'CNY', unit, source: value(sourceName) };
  }
  function selectedRating(name: string) { const selected = form.querySelector<HTMLInputElement>('input[name="' + name + '"]:checked'); return selected ? Number(selected.value) : null; }
  function buildPayload(type: EntityType) {
    if (type === 'venue') {
      const distanceMeters = numberOrNull('venueDistanceMeters');
      const distanceBasis = value('venueDistanceBasis');
      const hasDistance = distanceMeters !== null && Boolean(distanceBasis);
      return { name: value('venueName'), type: value('venueType'), campusScope: value('venueCategory'), location: { address: value('venueAddress'), campusArea: value('venueCampusArea') || null, floor: value('venueFloor') || null, distanceMeters: hasDistance ? Math.round(distanceMeters!) : null, distanceBasis: hasDistance ? distanceBasis : null }, tags: tags('venueTags'), description: value('venueDescription') || null, averagePrice: price('venuePrice', 'venuePriceSource', '人'), attachedReview: attachedReviewPayload() };
    }
    if (type === 'food') return { name: value('foodName'), venueId: value('foodVenueId'), mealType: value('foodMealType') || null, description: value('foodDescription') || null, price: price('foodPrice', 'foodPriceSource', '份'), tags: tags('foodTags'), attachedReview: attachedReviewPayload() };
    return { targetType: value('reviewTargetType'), targetId: value('reviewTargetId'), rating: selectedRating('reviewRating'), text: value('reviewText') };
  }
  function attachedReviewPayload() {
    if (!document.querySelector<HTMLInputElement>('#attached-enabled')!.checked) return undefined;
    return { rating: selectedRating('attachedRating'), text: value('attachedText') };
  }
  function parentData(type: EntityType) {
    if (type !== 'food') return undefined;
    const parentId = value('foodVenueId');
    const parentReceiptToken = readSession('shou-parent-receipt:' + parentId);
    return { venueEntityId: parentId, ...(parentReceiptToken ? { parentReceiptToken } : {}) };
  }
  function validate(type: EntityType) {
    const description = type === 'venue' ? value('venueDescription') : type === 'food' ? value('foodDescription') : value('reviewText');
    if (type === 'review' && !selectedRating('reviewRating')) return '独立评价必须选择 1–5 星。';
    if (type === 'review' && Array.from(description).length > 256) return '评价文字不能超过 256 个 Unicode 字符。';
    if ((type === 'venue' && (!value('venueName') || !value('venueAddress'))) || (type === 'food' && (!value('foodName') || !value('foodVenueId')))) return '请先填写名称和必要的位置或店铺信息。';
    if (type === 'venue' && Boolean(value('venueDistanceMeters')) !== Boolean(value('venueDistanceBasis'))) return '填写距离时，请同时选择距离依据；未知信息可留空。';
    if (type === 'venue' && value('venuePrice') && !value('venuePriceSource')) return '填写价格时，请同时填写价格来源。';
    if (type === 'food' && value('foodPrice') && !value('foodPriceSource')) return '填写价格时，请同时填写价格来源。';
    if (type !== 'review' && document.querySelector<HTMLInputElement>('#attached-enabled')!.checked) {
      if (!selectedRating('attachedRating')) return '附加评价需要选择 1–5 星。';
      if (Array.from(value('attachedText')).length > 256) return '附加评价文字不能超过 256 个 Unicode 字符。';
    }
    const allImages = entityImages.concat(reviewImages);
    if (allImages.length) {
      if (!value('image-source') || !value('image-holder') || !value('image-license') || !document.querySelector<HTMLInputElement>('#rights-confirmed')!.checked) return '请填写图片来源、版权方、许可并确认使用权。';
      if (allImages.some((image) => !image.alt.trim())) return '请为每张图片填写替代文本。';
    }
    return null;
  }
  async function submitImages(submissionId: string, token: string, version: number, images: ImageSelection[], slot: 'entity' | 'attachedReview', startIndex = 0, onVersion?: (nextVersion: number) => void) {
    let currentVersion = version;
    for (let index = startIndex; index < images.length; index += 1) {
      const image = images[index];
      const response = await fetch('/api/v2/submissions/' + encodeURIComponent(submissionId) + '/images', { method: 'POST', headers: { Authorization: 'Bearer ' + token, 'X-Image-Slot': slot, 'X-Image-Index': String(index), 'X-Submission-Version': String(currentVersion), ...metadataHeaders(image) }, body: await compressImage(image) });
      const body = await response.json();
      if (!response.ok) throw new Error(body.error?.message || '图片上传失败。');
      currentVersion = Number(body.version);
      onVersion?.(currentVersion);
    }
    return currentVersion;
  }
  async function receiptStatus(receipt: PendingReceipt) {
    const response = await fetch('/api/v2/submissions/' + encodeURIComponent(receipt.submissionId) + '/status', { headers: { Authorization: 'Bearer ' + receipt.receiptToken } });
    const body = await response.json();
    if (!response.ok) throw new Error(body.error?.message || '无法读取未完成投稿的状态。');
    return { version: Number(body.version), uploadedImages: Number(body.uploadedImages ?? 0), uploadedReviewImages: Number(body.uploadedReviewImages ?? 0), entityId: typeof body.entityId === 'string' ? body.entityId.trim() : '' };
  }
  async function finalizeReceipt(receipt: PendingReceipt, version: number) {
    const response = await fetch('/api/v2/submissions/' + encodeURIComponent(receipt.submissionId) + '/finalize', { method: 'POST', headers: { Authorization: 'Bearer ' + receipt.receiptToken, 'Content-Type': 'application/json' }, body: JSON.stringify({ expectedVersion: version, expectedImages: receipt.expectedImages, expectedReviewImages: receipt.expectedReviewImages }) });
    const body = await response.json();
    if (!response.ok) throw new Error(body.error?.message || '投稿完成步骤失败。');
    return body;
  }
  function resetSubmissionForm() {
    form.reset();
    entityImages.forEach((image) => URL.revokeObjectURL(image.preview));
    reviewImages.forEach((image) => URL.revokeObjectURL(image.preview));
    entityImages = [];
    reviewImages = [];
    renderPreviews('entity');
    renderPreviews('review');
    updateMetadataVisibility();
    switchType();
  }
  function draftData(type: EntityType) {
    const data: Record<string, unknown> = { schemaVersion: 2, entityType: type, snapshotId, fields: {} };
    const draftFields = data.fields as Record<string, string>;
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea').forEach((control) => {
      if (!control.name || control.type === 'file' || control.name === 'cf-turnstile-response') return;
      if (control.type === 'radio' && !(control as HTMLInputElement).checked) return;
      if (control.type === 'checkbox') { draftFields[control.name] = String((control as HTMLInputElement).checked); return; }
      draftFields[control.name] = control.value;
    });
    draftFields.entityImageCount = String(entityImages.length);
    draftFields.reviewImageCount = String(reviewImages.length);
    return data;
  }
  const widget = turnstileWidget();
  if (widget) document.querySelector('#turnstile-slot')!.append(widget);
  else {
    submitButton.disabled = true;
    showMessage('当前投稿服务暂不可用，请稍后再试；你仍可下载本地草稿。', 'info');
  }
  document.querySelectorAll<HTMLInputElement>('input[name="entityType"]').forEach((input) => input.addEventListener('change', switchType));
  document.querySelector<HTMLInputElement>('#attached-enabled')!.addEventListener('change', updateAttached);
  document.querySelectorAll<HTMLTextAreaElement>('textarea[maxlength="256"]').forEach((input) => input.addEventListener('input', () => updateCount(input.name)));
  inputFiles(entityInput, 'entity');
  inputFiles(reviewInput, 'review');
  receiptTokenToggle.addEventListener('click', () => {
    const reveal = receiptTokenInput.type === 'password';
    receiptTokenInput.type = reveal ? 'text' : 'password';
    receiptTokenToggle.textContent = reveal ? '隐藏' : '显示';
    receiptTokenToggle.setAttribute('aria-pressed', String(reveal));
  });
  const query = new URLSearchParams(location.search);
  const initialVenue = query.get('venue');
  const initialVenueEntityId = query.get('venueEntityId');
  const initialFood = query.get('food');
  if (initialVenue) { (fields('reviewTargetType') as HTMLSelectElement).value = 'venue'; (fields('reviewTargetId') as HTMLInputElement).value = initialVenue; (form.querySelector('input[name="entityType"][value="review"]') as HTMLInputElement).checked = true; }
  if (initialVenueEntityId) { (fields('foodVenueId') as HTMLInputElement).value = initialVenueEntityId; (form.querySelector('input[name="entityType"][value="food"]') as HTMLInputElement).checked = true; }
  if (initialFood) { (fields('reviewTargetType') as HTMLSelectElement).value = 'food'; (fields('reviewTargetId') as HTMLInputElement).value = initialFood; (form.querySelector('input[name="entityType"][value="review"]') as HTMLInputElement).checked = true; }
  switchType();
  restorePendingReceipt();
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const type = currentType();
    const problem = validate(type);
    if (problem) { showMessage(problem, 'error'); return; }
    if (!widget) return;
    submitButton.disabled = true;
    showMessage('正在提交投稿……', 'info');
    try {
      const token = String(form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value ?? '');
      if (!token.trim()) { showMessage('请先完成人机验证。', 'error'); return; }
      const entityImagesCount = Math.min(entityImages.length, type === 'review' ? 3 : 6);
      const attachedEnabled = type !== 'review' && document.querySelector<HTMLInputElement>('#attached-enabled')!.checked;
      const reviewImagesCount = attachedEnabled ? Math.min(reviewImages.length, 3) : 0;
      const payload = buildPayload(type);
      const response = await fetch('/api/v2/submissions', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Idempotency-Key': crypto.randomUUID().replaceAll('-', '') }, body: JSON.stringify({ schemaVersion: 2, entityType: type, snapshotId, payload, parent: parentData(type), expectedImages: entityImagesCount, expectedReviewImages: reviewImagesCount, turnstileToken: token }) });
      const result = await response.json();
