      const submissionId = String(result.submissionId ?? '');
      const receiptToken = String(result.receiptToken ?? '');
      const entityId = typeof result.entityId === 'string' ? result.entityId.trim() : '';
      if (!submissionId || !receiptToken || !Number.isSafeInteger(Number(result.version))) throw new Error('投稿回执无效，请稍后重试。');
      const receipt: PendingReceipt = { submissionId, receiptToken, version: Number(result.version), type, expectedImages: entityImagesCount, expectedReviewImages: reviewImagesCount, ...(entityId ? { entityId } : {}) };
