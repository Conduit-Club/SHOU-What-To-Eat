---
import Layout from '../templates/Layout.astro';
import QuickReview from '../components/QuickReview.astro';
---
<Layout title="餐饮详情">
  <main class="live-detail-shell">
    <div id="live-detail-content"><p>正在加载餐饮资料…</p></div>
    <QuickReview targetType="food" targetId="live-placeholder" targetName="这份推荐" />
  </main>
</Layout>
<script>
  import { initReviewAvatars } from '../utils/review-identity';
  initReviewAvatars();
  // A return to an open detail page revalidates its data without throwing away
  // a review the visitor is writing. Show a reload action when it changed.
  const main=document.querySelector<HTMLElement>('#live-detail-content');
  window.addEventListener('focus',async()=>{
    if(!main?.dataset.revision||document.querySelector('[data-live-update]'))return;
    try{const response=await fetch('/api/v2/public/version',{cache:'no-store'});if(!response.ok)return;const data=await response.json();if(String(data.revision)!==main.dataset.revision){const button=document.createElement('button');button.dataset.liveUpdate='';button.className='live-update';button.textContent='资料有更新，点击刷新';button.onclick=()=>location.reload();main.prepend(button);}}catch{/* keep the visible version; never replace a draft */}
  });
</script>
<style is:global>
  .review-author{display:flex;align-items:center;gap:10px;min-width:0}.review-author strong{min-width:0;overflow-wrap:anywhere;font-size:13px}.review-author-avatar{position:relative;display:grid;place-items:center;flex:none;width:36px;height:36px;overflow:hidden;border-radius:50%;background:var(--surface-card);color:var(--orange-deep);font-weight:750;font-size:14px}.review-author-avatar img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.review-author-avatar img[hidden]{display:none}
</style>
<style is:global>
  .live-detail-shell{width:calc(100% - clamp(32px,4vw,96px));margin:auto;padding:28px 0 60px}.live-detail-shell .quick-review{max-width:1100px;margin-top:35px}.live-breadcrumb{display:flex;justify-content:space-between;padding-bottom:22px;border-bottom:1px solid var(--line);color:var(--muted);font-size:13px}.live-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:clamp(24px,4vw,64px);margin:36px 0}.live-hero.without-photo{grid-template-columns:1fr}.live-cover{margin:0;min-width:0}.live-cover img,.live-placeholder{width:100%;height:clamp(230px,30vw,490px);object-fit:cover;border-radius:25px;background:var(--theme-soft,#f7ece1)}.live-placeholder{display:grid;place-items:center;color:var(--theme-text,#9d7d65)}.live-cover figcaption{font-size:11px;line-height:1.7;color:var(--muted);margin-top:10px}.live-info h1{font-size:clamp(32px,4vw,66px);line-height:1.2;overflow-wrap:anywhere;margin:14px 0 22px}.live-info p{line-height:1.9;color:var(--muted);white-space:pre-line}.live-price{font-size:28px;color:var(--orange-deep);font-weight:800}.live-tags{display:flex;flex-wrap:wrap;gap:10px;margin:20px 0}.live-tags span{padding:7px 13px;background:var(--theme-soft,#fff0e3);border-radius:20px;font-size:12px}.live-section{background:var(--surface-card);padding:clamp(20px,3vw,36px);border:1px solid var(--line);border-radius:24px;margin:25px 0}.live-section h2{font-size:24px}.live-reviews{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.live-review{padding:22px;background:var(--theme-soft,#faf7f2);border-radius:16px;min-width:0}.live-review p{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.9}.live-stars{color:var(--theme-text,#ac7c16);letter-spacing:3px}.live-review small,.live-section small{color:var(--muted)}.live-gallery{display:flex;gap:12px;flex-wrap:wrap}.live-gallery figure{width:180px;margin:8px 0}.live-gallery img{width:100%;height:145px;object-fit:cover;border-radius:14px}.live-gallery figcaption{font-size:10px;line-height:1.6;color:var(--muted)}.live-food-links{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}.live-food-links a{border:1px solid var(--line);padding:18px;border-radius:14px}.live-update{padding:14px 20px;border:1px solid #e8b57b;border-radius:12px;background:var(--theme-soft,#fff2df);color:var(--theme-text,#854313)}.live-source{font-size:12px;overflow-wrap:anywhere;line-height:1.8}@media(max-width:700px){.live-hero{grid-template-columns:1fr;gap:18px;margin-top:24px}.live-cover img,.live-placeholder{height:260px}.live-reviews{grid-template-columns:1fr}.live-info h1{font-size:38px}.live-gallery figure{width:calc(50% - 8px)}}
</style>
