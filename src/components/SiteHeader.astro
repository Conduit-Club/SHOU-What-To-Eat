---
const pathname = Astro.url.pathname;
---
<header class="site-header">
  <a class="site-brand" href="/" aria-label="今日海大吃什么首页"><span class="site-logo" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M6 14h20c0 9-5 13-10 13S6 23 6 14Z"/><path d="m9 5 18-2M9 9l18-2"/></svg></span><span>今日吃什么<small>上海海洋大学 · 临港</small></span></a>
  <nav class="site-links" aria-label="目录导航"><a href="/" aria-current={pathname === '/' ? 'page' : undefined}>首页</a><a href="/foods/" aria-current={pathname.startsWith('/foods/') ? 'page' : undefined}>找餐品</a><a href="/restaurants/" aria-current={pathname.startsWith('/restaurants/') ? 'page' : undefined}>找店铺</a><a href="/status/" aria-current={pathname.startsWith('/status') ? 'page' : undefined}>投稿进度</a></nav>
  <div class="site-actions">
  <div class="account-controls" data-account-controls>
    <div class="account-guest" data-account-guest><a href="/auth/login" data-account-login>登录</a><a href="/auth/register" data-account-register>注册</a></div>
    <details class="account-member" data-account-member hidden>
      <summary aria-label="账号菜单"><img data-account-avatar hidden alt="" referrerpolicy="no-referrer" width="30" height="30" /><span class="account-initial" data-account-initial aria-hidden="true"></span><span data-account-name></span><span aria-hidden="true">⌄</span></summary>
      <div class="account-menu"><a href="/auth/account">账号与头像</a><a href="/manage/" data-account-admin hidden>内容管理</a><a href="/auth/login?returnTo=%2Fmanage%2F" data-account-renew hidden>确认管理员身份</a><form action="/auth/logout" method="post"><input type="hidden" name="csrfToken" data-account-csrf /><input type="hidden" name="returnTo" data-account-return /><button type="submit">退出本站</button></form></div>
    </details>
    <span class="account-unavailable" data-account-unavailable hidden>账号暂不可用</span>
  </div>
  <button class="theme-toggle" type="button" aria-label="切换明暗主题" title="切换明暗主题">
    <svg class="theme-moon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z"/></svg>
    <svg class="theme-sun" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
    <span class="theme-label">切换主题</span>
  </button>
  </div>
</header>
<script>
  import { fetchAccountSession, loginHref } from '../utils/auth-session';
  const controls = document.querySelector<HTMLElement>('[data-account-controls]');
  if (controls) {
    const element = <T extends HTMLElement>(selector: string) => controls.querySelector<T>(selector)!;
    const returnTo = () => location.pathname + location.search + location.hash;
    const refresh = async () => {
      element<HTMLAnchorElement>('[data-account-login]').href = loginHref(returnTo());
      element<HTMLAnchorElement>('[data-account-register]').href = '/auth/register?' + new URLSearchParams({ returnTo: returnTo() });
      element<HTMLInputElement>('[data-account-return]').value = returnTo();
      try {
        const session = await fetchAccountSession();
        element('[data-account-guest]').hidden = Boolean(session.user) || !session.configured;
        element('[data-account-member]').hidden = !session.user;
        element('[data-account-unavailable]').hidden = session.configured;
        if (session.user) {
          element('[data-account-name]').textContent = session.user.username;
          element('[data-account-initial]').textContent = Array.from(session.user.username)[0];
          const avatar = element<HTMLImageElement>('[data-account-avatar]');
          avatar.hidden = !session.user.picture;
          element('[data-account-initial]').hidden = Boolean(session.user.picture);
          if (session.user.picture) avatar.src = session.user.picture;
          else avatar.removeAttribute('src');
          element<HTMLInputElement>('[data-account-csrf]').value = session.csrfToken ?? '';
          element('[data-account-admin]').hidden = !session.user.isAdmin;
          element('[data-account-renew]').hidden = !session.user.wasAdmin || session.user.isAdmin;
        }
      } catch { /* The working login links remain available if the status read fails. */ }
    };
    void refresh();
    window.addEventListener('focus', () => void refresh());
    window.addEventListener('hashchange', () => void refresh());
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') void refresh(); });
    setInterval(() => { if (document.visibilityState === 'visible') void refresh(); }, 60000);
    element<HTMLImageElement>('[data-account-avatar]').addEventListener('error', () => { element('[data-account-avatar]').hidden = true; element('[data-account-initial]').hidden = false; });
    controls.querySelector('form')!.addEventListener('submit', () => { element<HTMLInputElement>('[data-account-return]').value = returnTo(); });
    document.addEventListener('click', event => { const member = element<HTMLDetailsElement>('[data-account-member]'); if (!member.contains(event.target as Node)) member.open = false; });
  }
</script>
<style>
  .site-header{width:calc(100% - clamp(32px,4vw,96px));margin:auto;min-height:94px;display:flex;align-items:center;justify-content:space-between;gap:28px;border-bottom:1px solid var(--line)}
  .site-brand{display:flex;align-items:center;gap:12px;flex-shrink:0;text-decoration:none;font-size:24px;font-weight:850;color:var(--orange-deep);letter-spacing:-.04em}.site-brand small{display:block;margin-top:3px;color:var(--muted);font-size:10px;font-weight:600;letter-spacing:.08em}.site-logo{width:48px;height:48px;display:grid;place-items:center;background:var(--orange-bright);border-radius:17px;color:#fff}.site-logo svg{width:30px;height:30px;fill:none;stroke:currentColor;stroke-width:2.3;stroke-linecap:round;stroke-linejoin:round}
  .site-links{display:flex;gap:22px;align-items:center}.site-links a{min-height:48px;display:flex;align-items:center;font-size:14px;font-weight:750;text-decoration:none;color:var(--muted);border-bottom:2px solid transparent}.site-links a[aria-current]{color:var(--orange-deep);border-color:var(--orange)}
  .site-actions{display:flex;align-items:center;gap:14px}.account-controls [hidden]{display:none!important}.account-guest{display:flex;gap:12px;font-size:13px;font-weight:750}.account-guest a{padding:12px 0;text-decoration:none;color:var(--orange-deep)}.account-member{position:relative}.account-member summary{display:flex;align-items:center;gap:8px;cursor:pointer;min-height:44px;font-size:13px;font-weight:750;list-style:none}.account-member summary::-webkit-details-marker{display:none}.account-member summary>span[data-account-name]{max-width:110px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.account-member img,.account-initial{width:30px;height:30px;border-radius:50%;object-fit:cover}.account-initial{display:grid;place-items:center;background:var(--surface-soft);color:var(--orange-deep);border:1px solid var(--line)}.account-menu{position:absolute;z-index:80;right:0;top:100%;margin-top:8px;width:180px;padding:8px;background:var(--surface-card);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow-hover)}.account-menu a,.account-menu button{display:block;width:100%;padding:12px;border:0;background:transparent;text-align:left;text-decoration:none;color:var(--ink);font-size:13px;border-radius:10px}.account-menu a:hover,.account-menu button:hover{background:var(--surface-soft)}.account-unavailable{font-size:12px;color:var(--muted)}
  .theme-toggle{display:flex;align-items:center;justify-content:center;gap:9px;flex:none;min-height:46px;padding:0 17px;border:1px solid var(--line);border-radius:999px;background:var(--surface-card);color:var(--ink);font-size:12px;font-weight:750}.theme-toggle svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.theme-sun{display:none}:global([data-theme=dark]) .theme-sun{display:block}:global([data-theme=dark]) .theme-moon{display:none}
  @media(max-width:960px){.site-links{gap:14px}.theme-label{display:none}.theme-toggle{padding:0 13px}}
  @media(max-width:760px){.site-header{min-height:76px;gap:12px}.site-brand{font-size:20px;gap:9px}.site-logo{width:40px;height:40px;border-radius:14px}.site-links{display:none}.site-actions{gap:10px}.account-member summary>span[data-account-name]{max-width:64px}.account-guest{gap:8px}.theme-toggle{padding:0 10px;min-height:44px}.theme-label{display:none}}
  @media(max-width:360px){.site-brand{font-size:18px}.site-logo{width:34px;height:34px}.account-member summary>span[data-account-name]{max-width:44px}.site-actions{gap:7px}}
  @media(max-width:400px){.site-header{gap:8px}.site-brand{font-size:18px;gap:7px}.site-logo{width:34px;height:34px}.site-brand small{font-size:9px;letter-spacing:0}.site-actions{gap:7px}.account-member summary>span[data-account-name]{display:none}.account-member summary{gap:5px}.account-guest{font-size:12px;gap:7px}.theme-toggle{width:40px;padding:0;min-height:42px}}
</style>
