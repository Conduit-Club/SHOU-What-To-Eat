---
interface Props { name?: string }
const { name = 'visitedAt' } = Astro.props;
---
<label class="dining-date"><span>用餐日期 <small>可修改</small></span><input type="date" name={name} data-dining-date data-label="用餐日期" /><small>默认今天（UTC+8）；若是之前吃的，请改为实际日期。</small></label>
<script>
  import { diningDate } from '../utils/dining-date';
  document.querySelectorAll<HTMLInputElement>('[data-dining-date]').forEach(input => {
    const today = diningDate();
    input.value = input.defaultValue = input.max = today;
    input.addEventListener('focus', () => { input.max = diningDate(); });
    input.form?.addEventListener('reset', () => { input.defaultValue = input.max = diningDate(); });
  });
</script>
<style>
  .dining-date{display:grid;gap:8px;min-width:0;margin:20px 0;font-size:12px}.dining-date>span{font-weight:700}.dining-date small{color:var(--muted);font-size:11px;font-weight:400;line-height:1.7}.dining-date>span>small{margin-left:8px}.dining-date input{width:min(100%,240px);min-width:0;min-height:44px;padding:9px 12px;border:1px solid var(--line);border-radius:10px;background:var(--surface-card);color:var(--ink);font:inherit;font-size:16px}
</style>
