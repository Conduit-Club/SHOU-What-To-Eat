<aside id="form-notice" class="form-notice" hidden tabindex="-1" aria-live="assertive" aria-atomic="true">
  <span class="notice-icon" aria-hidden="true"></span><div><strong data-notice-title></strong><ul data-notice-items></ul></div>
  <button type="button" aria-label="关闭提示">×</button>
</aside>
<script>
  document.querySelector('#form-notice button')?.addEventListener('click', () => {
    document.querySelector<HTMLElement>('#form-notice')!.hidden = true;
  });
</script>
<style is:global>
  .form-notice{position:fixed;z-index:1000;top:16px;left:50%;transform:translateX(-50%);display:flex;gap:12px;align-items:start;width:min(580px,calc(100% - 32px));max-height:44vh;overflow:auto;padding:17px 18px;border:1px solid #e39b9b;border-radius:18px;background:#fff1f0;color:#922d2d;box-shadow:0 12px 35px #613b302b;font-size:13px;line-height:1.7}.form-notice[hidden]{display:none}.form-notice[data-tone=success]{border-color:#9dcbaa;background:#edf9f0;color:#165f36}.form-notice>div{min-width:0;flex:1}.form-notice strong{font-size:14px}.form-notice ul{margin:4px 0 0;padding-left:17px}.form-notice ul:empty{display:none}.notice-icon{display:grid;place-items:center;width:25px;height:25px;flex:none;border-radius:50%;background:#f3ceca;font-size:16px;font-weight:800}.form-notice[data-tone=success] .notice-icon{background:#cce9d6}.form-notice button{flex:none;min-width:44px;min-height:44px;margin:-9px -9px -9px 0;border:0;border-radius:10px;background:transparent;color:inherit;font-size:22px}.required-mark{color:#c43232;font-size:14px;font-weight:800;margin-left:3px}.field-invalid{display:block;color:#ad302d;font-size:11px;font-weight:500;margin-top:5px;line-height:1.6}[aria-invalid=true]{border-color:#c54a44!important;outline-color:#c54a44!important;scroll-margin-top:190px}
</style>
