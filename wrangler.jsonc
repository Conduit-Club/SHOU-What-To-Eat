{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "what-to-eat-in-shou-today-done-right",
  "main": "src/worker/index.ts",
  "tsconfig": "src/worker/tsconfig.json",
  "compatibility_date": "2026-09-30",
  "ratelimits": [
    { "name": "AUTH_IP_LIMITER", "namespace_id": "6701", "simple": { "limit": 6, "period": 60 } },
    { "name": "AUTH_SITE_LIMITER", "namespace_id": "6702", "simple": { "limit": 12, "period": 60 } }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/auth", "/auth/*", "/api", "/api/*", "/media/*", "/foods/*", "/restaurants/*", "/catalog-index.json", "/catalog-snapshot.json"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "shou-food",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "REPLACE_WITH_R2_BUCKET_NAME" }],
  "vars": {
    "MEDIA_MODE": "r2",
    "ALLOWED_ORIGINS": "http://localhost:4321",
    "TURNSTILE_HOSTNAME": "eat.shoumc.com",
    "PUBLIC_TURNSTILE_SITE_KEY": "replace-with-public-turnstile-site-key",
    "GITHUB_REPOSITORY": "Conduit-Club/SHOU-What-To-Eat",
    "PUBLICATION_ENABLED": "false"
  },
  "triggers": { "crons": [] },
  "env": {
    "preview": {
      "name": "what-to-eat-in-shou-today-done-right-preview",
      "ratelimits": [
        { "name": "AUTH_IP_LIMITER", "namespace_id": "6711", "simple": { "limit": 6, "period": 60 } },
        { "name": "AUTH_SITE_LIMITER", "namespace_id": "6712", "simple": { "limit": 12, "period": 60 } }
      ],
      "workers_dev": true,
      "d1_databases": [{
        "binding": "DB",
        "database_name": "shou-food-preview",
        "database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID",
        "migrations_dir": "migrations"
      }],
      "vars": {
        "MEDIA_MODE": "r2",
        "ALLOWED_ORIGINS": "http://localhost:4321",
        "TURNSTILE_HOSTNAME": "eat.shoumc.com",
        "PUBLIC_TURNSTILE_SITE_KEY": "replace-with-public-turnstile-site-key",
        "GITHUB_REPOSITORY": "Conduit-Club/SHOU-What-To-Eat",
        "PUBLICATION_ENABLED": "false"
      },
      "triggers": { "crons": [] }
    },
    "production": {
      "name": "what-to-eat-in-shou-today-done-right",
      "ratelimits": [
        { "name": "AUTH_IP_LIMITER", "namespace_id": "6721", "simple": { "limit": 6, "period": 60 } },
        { "name": "AUTH_SITE_LIMITER", "namespace_id": "6722", "simple": { "limit": 12, "period": 60 } }
      ],
      "workers_dev": false,
      "routes": [{ "pattern": "eat.shoumc.com", "custom_domain": true }],
      "d1_databases": [{
        "binding": "DB",
        "database_name": "shou-food",
        "database_id": "REPLACE_WITH_D1_DATABASE_ID",
        "migrations_dir": "migrations"
      }],
      "vars": {
        "OIDC_ISSUER": "https://auth.shoumc.com/api/auth",
        "OIDC_CLIENT_ID": "shou-eat-production",
        "OIDC_REDIRECT_URI": "https://eat.shoumc.com/auth/callback",
        "MEDIA_MODE": "r2",
        "ALLOWED_ORIGINS": "https://eat.shoumc.com",
        "TURNSTILE_HOSTNAME": "eat.shoumc.com",
        "PUBLIC_TURNSTILE_SITE_KEY": "replace-with-public-turnstile-site-key",
        "GITHUB_REPOSITORY": "Conduit-Club/SHOU-What-To-Eat",
        "PUBLICATION_ENABLED": "false"
      },
      "triggers": { "crons": [] }
    }
  }
}
