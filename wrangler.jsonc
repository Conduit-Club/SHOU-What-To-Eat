{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "what-to-eat-in-shou-today-done-right",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "shou-food", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "vars": { "MEDIA_MODE": "external", "ALLOWED_ORIGINS": "http://localhost:4321", "GITHUB_REPOSITORY": "Conduit-Club/what-to-eat-in-shou-today-done-right" },
  "triggers": { "crons": ["*/2 * * * *"] }
}
