# 仅用于 wrangler dev；不要提交 .dev.vars 或填入真实生产密钥。
# 生产和预览部署的 D1/R2 标识通过环境变量注入并写入被忽略的
# wrangler.generated.*.jsonc；不要把它们写入本文件或提交到仓库。
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
TURNSTILE_HOSTNAME=eat.shoumc.com
PUBLIC_TURNSTILE_SITE_KEY=replace-with-public-turnstile-site-key
ACCESS_REVIEWER_EMAIL=replace-with-access-reviewer-email
MEDIA_MODE=r2
# IMAGES is an R2 binding generated by prepare-wrangler-config.mjs, not a var.
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=replace-with-access-application-audience
OIDC_ISSUER=https://auth.shoumc.com/api/auth
OIDC_CLIENT_ID=shou-eat-local
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
OIDC_REDIRECT_URI=http://localhost:8789/auth/callback
OIDC_ALLOW_LOCAL_HTTP=true
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-with-private-key\\n-----END PRIVATE KEY-----"
GITHUB_INSTALLATION_ID=replace-with-github-installation-id
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret
DEPLOY_WEBHOOK_SECRET=replace-with-random-deploy-webhook-secret
